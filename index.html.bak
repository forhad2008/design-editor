<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>ARTFORGE — Image To Artwork Maker</title>

<meta name="description"
content="Professional browser-based image artwork editor with gradients, text, patterns, textures and export tools.">

<style>
@import url('https://fonts.googleapis.com/css2?family=Bangers&family=Caveat:wght@600&family=Cinzel:wght@600;800&family=Inter:wght@400;500;600;700;800&family=Montserrat:wght@400;600;800&family=Orbitron:wght@600;800&family=Pacifico&family=Playfair+Display:wght@500;600;700&family=Roboto+Mono:wght@400;600&display=swap');

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

:root{
    --bg:#070707;
    --panel:#101010;
    --panel2:#151515;
    --panel3:#1b1b1b;
    --border:rgba(255,255,255,.09);
    --border2:rgba(255,255,255,.15);
    --text:#f5f5f5;
    --muted:#888;
    --accent:#c1121f;
    --accent2:#ff3545;
    --green:#40d98a;
}

html{
    scroll-behavior:smooth;
}

body{
    min-height:100vh;
    background:
        radial-gradient(
            circle at 10% 0%,
            rgba(193,18,31,.12),
            transparent 28%
        ),
        radial-gradient(
            circle at 90% 100%,
            rgba(193,18,31,.08),
            transparent 30%
        ),
        #070707;
    color:var(--text);
    font-family:Inter,Arial,sans-serif;
}

/* =========================================================
   HEADER
========================================================= */

header{
    height:76px;
    padding:0 30px;
    border-bottom:1px solid var(--border);
    background:rgba(7,7,7,.86);
    backdrop-filter:blur(22px);
    display:flex;
    align-items:center;
    justify-content:space-between;
    position:sticky;
    top:0;
    z-index:1000;
}

.logo{
    font-size:20px;
    font-weight:800;
    letter-spacing:-.8px;
}

.logo span{
    color:var(--accent2);
}

.header-right{
    display:flex;
    align-items:center;
    gap:10px;
}

.badge{
    border:1px solid var(--border);
    color:#999;
    font-size:10px;
    letter-spacing:1.6px;
    padding:8px 12px;
    border-radius:30px;
}

/* =========================================================
   MAIN
========================================================= */

main{
    width:min(1550px,95%);
    margin:auto;
    padding:42px 0 70px;
}

.hero{
    text-align:center;
    max-width:850px;
    margin:0 auto 38px;
}

.eyebrow{
    color:var(--accent2);
    font-size:10px;
    letter-spacing:3px;
    font-weight:800;
    margin-bottom:13px;
}

.hero h1{
    font-family:"Playfair Display",serif;
    font-size:clamp(42px,6vw,76px);
    line-height:1;
    letter-spacing:-3px;
}

.hero p{
    max-width:650px;
    margin:17px auto 0;
    color:#818181;
    line-height:1.7;
    font-size:14px;
}

/* =========================================================
   APP
========================================================= */

.editor{
    display:grid;
    grid-template-columns:350px minmax(0,1fr) 320px;
    gap:16px;
    align-items:start;
}

/* =========================================================
   PANELS
========================================================= */

.panel{
    background:rgba(15,15,15,.9);
    border:1px solid var(--border);
    border-radius:22px;
    overflow:hidden;
}

.panel-inner{
    padding:18px;
}

.panel-title{
    padding:17px 18px;
    border-bottom:1px solid var(--border);
    font-size:11px;
    letter-spacing:1.7px;
    text-transform:uppercase;
    color:#aaa;
    font-weight:800;
}

.left-panel,
.right-panel{
    position:sticky;
    top:94px;
    max-height:calc(100vh - 112px);
    overflow:auto;
}

.left-panel::-webkit-scrollbar,
.right-panel::-webkit-scrollbar{
    width:5px;
}

.left-panel::-webkit-scrollbar-thumb,
.right-panel::-webkit-scrollbar-thumb{
    background:#292929;
    border-radius:20px;
}

/* =========================================================
   SECTIONS
========================================================= */

.section{
    padding-bottom:22px;
    margin-bottom:20px;
    border-bottom:1px solid var(--border);
}

.section:last-child{
    border-bottom:0;
    margin-bottom:0;
    padding-bottom:0;
}

.section-heading{
    font-size:10px;
    color:#777;
    letter-spacing:1.6px;
    text-transform:uppercase;
    font-weight:800;
    margin-bottom:12px;
}

.control{
    margin-bottom:13px;
}

.control:last-child{
    margin-bottom:0;
}

.label{
    display:block;
    color:#aaa;
    font-size:11px;
    margin-bottom:7px;
}

select,
input[type=text],
input[type=number]{
    width:100%;
    height:40px;
    background:#181818;
    border:1px solid var(--border);
    color:#eee;
    border-radius:10px;
    padding:0 11px;
    outline:none;
}

select:focus,
input[type=text]:focus,
input[type=number]:focus{
    border-color:rgba(255,53,69,.55);
}

/* =========================================================
   UPLOAD
========================================================= */

.upload{
    border:1px dashed #393939;
    border-radius:17px;
    padding:23px 15px;
    text-align:center;
    cursor:pointer;
    transition:.2s;
}

.upload:hover,
.upload.dragging{
    border-color:var(--accent2);
    background:rgba(193,18,31,.06);
}

.upload-icon{
    width:48px;
    height:48px;
    border-radius:15px;
    background:#191919;
    display:grid;
    place-items:center;
    margin:0 auto 11px;
    font-size:22px;
}

.upload strong{
    display:block;
    font-size:13px;
}

.upload small{
    display:block;
    color:#666;
    font-size:10px;
    margin-top:6px;
}

input[type=file]{
    display:none;
}

/* =========================================================
   RANGE
========================================================= */

.range-row{
    display:flex;
    align-items:center;
    gap:9px;
}

input[type=range]{
    flex:1;
    accent-color:var(--accent2);
}

.range-value{
    width:45px;
    text-align:right;
    color:#aaa;
    font-size:10px;
}

/* =========================================================
   COLOR
========================================================= */

.color-list{
    display:flex;
    flex-direction:column;
    gap:7px;
}

.color-row{
    display:flex;
    gap:7px;
}

.color-picker{
    width:43px;
    height:40px;
    padding:3px;
    border-radius:9px;
    border:1px solid var(--border);
    background:#191919;
}

.color-hex{
    flex:1;
}

.icon-btn{
    width:40px;
    height:40px;
    background:#191919;
    color:#888;
    border:1px solid var(--border);
    border-radius:9px;
    cursor:pointer;
}

.icon-btn:hover{
    color:#fff;
}

.add-btn{
    width:100%;
    height:39px;
    margin-top:8px;
    background:transparent;
    border:1px dashed #3b3b3b;
    color:#999;
    border-radius:10px;
    cursor:pointer;
}

.add-btn:hover{
    color:#fff;
    border-color:#666;
}

/* =========================================================
   PRESETS
========================================================= */

.preset-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:7px;
}

.preset{
    height:38px;
    border-radius:9px;
    border:2px solid transparent;
    cursor:pointer;
}

.preset:hover{
    transform:translateY(-1px);
}

.preset.active{
    border-color:#fff;
}

/* =========================================================
   BUTTONS
========================================================= */

.button{
    height:42px;
    padding:0 14px;
    border-radius:10px;
    border:1px solid var(--border);
    background:#191919;
    color:#eee;
    cursor:pointer;
    font-weight:600;
    font-size:11px;
    transition:.2s;
}

.button:hover{
    background:#232323;
}

.button.primary{
    background:var(--accent);
    border-color:var(--accent);
}

.button.primary:hover{
    background:#e12231;
}

.button.light{
    background:#f5f5f5;
    color:#090909;
    border-color:#fff;
}

.full{
    width:100%;
}

.two{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:8px;
}

/* =========================================================
   TEXT LAYERS
========================================================= */

.text-add{
    display:grid;
    grid-template-columns:1fr 48px;
    gap:7px;
}

.text-add button{
    width:48px;
}

.layers{
    display:flex;
    flex-direction:column;
    gap:7px;
    margin-top:10px;
}

.layer{
    min-height:43px;
    display:flex;
    align-items:center;
    gap:8px;
    background:#181818;
    border:1px solid var(--border);
    border-radius:10px;
    padding:7px 8px;
    cursor:pointer;
}

.layer.active{
    border-color:rgba(255,53,69,.65);
    background:#1d1213;
}

.layer-name{
    flex:1;
    overflow:hidden;
    white-space:nowrap;
    text-overflow:ellipsis;
    font-size:11px;
}

.layer-delete{
    width:28px;
    height:28px;
    border:0;
    background:transparent;
    color:#777;
    cursor:pointer;
}

.layer-delete:hover{
    color:#fff;
}

/* =========================================================
   TEXT COLOR
========================================================= */

.text-color-row{
    display:flex;
    gap:8px;
}

.text-color{
    width:46px;
    height:40px;
    padding:3px;
    border-radius:9px;
    border:1px solid var(--border);
    background:#181818;
}

/* =========================================================
   PATTERN PREVIEW
========================================================= */

.pattern-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:7px;
}

.pattern-option{
    height:42px;
    border:1px solid var(--border);
    border-radius:9px;
    cursor:pointer;
    background-color:#222;
    position:relative;
    overflow:hidden;
}

.pattern-option.active{
    border:2px solid #fff;
}

/* =========================================================
   CANVAS
========================================================= */

.workspace{
    min-width:0;
}

.canvas-panel{
    min-height:730px;
    padding:17px;
    background:rgba(15,15,15,.9);
    border:1px solid var(--border);
    border-radius:22px;
    display:flex;
    flex-direction:column;
}

.canvas-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin-bottom:12px;
}

.image-info{
    min-width:0;
    color:#777;
    font-size:10px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.format-buttons{
    display:flex;
    gap:5px;
}

.format{
    border:1px solid var(--border);
    background:#181818;
    color:#999;
    padding:8px 11px;
    border-radius:8px;
    cursor:pointer;
    font-size:10px;
    font-weight:700;
}

.format.active{
    background:#fff;
    color:#111;
}

.canvas-wrap{
    flex:1;
    min-height:590px;
    border-radius:16px;
    overflow:hidden;
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;

    background-color:#101010;

    background-image:
        linear-gradient(45deg,#191919 25%,transparent 25%),
        linear-gradient(-45deg,#191919 25%,transparent 25%),
        linear-gradient(45deg,transparent 75%,#191919 75%),
        linear-gradient(-45deg,transparent 75%,#191919 75%);

    background-size:24px 24px;
    background-position:
        0 0,
        0 12px,
        12px -12px,
        -12px 0;
}

#canvas{
    max-width:100%;
    max-height:680px;
    width:auto;
    height:auto;
    display:block;
    box-shadow:0 30px 80px rgba(0,0,0,.55);
}

.empty{
    position:absolute;
    text-align:center;
    color:#555;
    pointer-events:none;
}

.empty-icon{
    font-size:46px;
    margin-bottom:8px;
}

.empty h2{
    color:#aaa;
    font-size:15px;
}

.empty p{
    font-size:11px;
    margin-top:6px;
}

/* =========================================================
   STATUS
========================================================= */

.status{
    margin-top:12px;
    padding-top:12px;
    border-top:1px solid var(--border);
    display:flex;
    justify-content:space-between;
    color:#666;
    font-size:10px;
}

.dot{
    display:inline-block;
    width:6px;
    height:6px;
    border-radius:50%;
    background:#555;
    margin-right:6px;
}

.ready .dot{
    background:var(--green);
}

/* =========================================================
   EXPORT
========================================================= */

.export-name{
    display:flex;
    gap:7px;
}

.export-name input{
    flex:1;
}

.extension{
    width:70px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#191919;
    border:1px solid var(--border);
    border-radius:10px;
    color:#777;
    font-size:10px;
}

/* =========================================================
   MOBILE TOOLBAR
========================================================= */

.mobile-export{
    display:none;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:1250px){

    .editor{
        grid-template-columns:310px minmax(0,1fr);
    }

    .right-panel{
        grid-column:1 / -1;
        position:static;
        max-height:none;
    }

    .right-panel .panel-inner{
        display:grid;
        grid-template-columns:repeat(2,1fr);
        gap:20px;
    }

}

@media(max-width:850px){

    main{
        padding-top:30px;
    }

    .editor{
        display:block;
    }

    .left-panel,
    .right-panel{
        position:static;
        max-height:none;
        margin-bottom:14px;
    }

    .canvas-panel{
        min-height:550px;
    }

    .canvas-wrap{
        min-height:440px;
    }

    .right-panel .panel-inner{
        display:block;
    }

}

@media(max-width:600px){

    header{
        height:64px;
        padding:0 15px;
    }

    .logo{
        font-size:17px;
    }

    .badge{
        display:none;
    }

    main{
        width:94%;
        padding-bottom:35px;
    }

    .hero{
        margin-bottom:25px;
    }

    .hero h1{
        font-size:42px;
        letter-spacing:-2px;
    }

    .hero p{
        font-size:12px;
    }

    .panel,
    .canvas-panel{
        border-radius:17px;
    }

    .panel-inner{
        padding:14px;
    }

    .canvas-panel{
        padding:12px;
    }

    .canvas-toolbar{
        align-items:flex-start;
        flex-direction:column;
    }

    .format-buttons{
        width:100%;
    }

    .format{
        flex:1;
    }

    .canvas-wrap{
        min-height:360px;
    }

    #canvas{
        max-height:500px;
    }

    .status{
        flex-direction:column;
        gap:6px;
    }

    .two{
        grid-template-columns:1fr;
    }

}

/* =========================================================
   SMALL MOBILE
========================================================= */

@media(max-width:380px){

    .hero h1{
        font-size:36px;
    }

    .preset-grid{
        grid-template-columns:repeat(2,1fr);
    }

}

/* =========================================================
   ARTFORGE PRO UI UPGRADE
========================================================= */
:root{
  --bg:#06070a; --panel:rgba(17,20,27,.82); --panel2:rgba(22,26,35,.92);
  --panel3:#1c2230; --border:rgba(255,255,255,.10); --border2:rgba(255,255,255,.18);
  --text:#f7f8fb; --muted:#8c94a3; --accent:#7c5cff; --accent2:#00d4ff;
  --success:#48e6a1; --danger:#ff5470; --shadow:0 24px 80px rgba(0,0,0,.42);
}
body{
 background:
 radial-gradient(circle at 12% 8%,rgba(124,92,255,.16),transparent 28%),
 radial-gradient(circle at 88% 18%,rgba(0,212,255,.10),transparent 25%),
 radial-gradient(circle at 50% 110%,rgba(255,84,112,.08),transparent 35%),#06070a;
}
header{
 height:70px!important; padding:0 24px!important; background:rgba(6,7,10,.72)!important;
 border-bottom:1px solid rgba(255,255,255,.08)!important; box-shadow:0 10px 35px rgba(0,0,0,.18);
}
.logo{font-size:19px!important; letter-spacing:-.6px!important}
.logo span{color:#9a85ff!important}
.header-right{gap:8px}
.badge{background:rgba(255,255,255,.035);box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}
main{width:min(1640px,96%)!important;padding:28px 0 60px!important}
.hero{max-width:1050px!important;margin-bottom:25px!important}
.eyebrow{color:#9a85ff!important;letter-spacing:3.5px!important}
.hero h1{
 background:linear-gradient(100deg,#fff 10%,#bcb4ff 48%,#72e6ff 90%);
 -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero p{color:#8f97a6!important}
.editor{grid-template-columns:365px minmax(0,1fr) 330px!important;gap:14px!important}
.panel,.canvas-panel{
 background:linear-gradient(180deg,rgba(20,24,32,.88),rgba(11,13,18,.94))!important;
 border:1px solid rgba(255,255,255,.09)!important;box-shadow:var(--shadow);
 border-radius:20px!important;
}
.panel-title{color:#c3c9d5!important;background:rgba(255,255,255,.018)}
.panel-inner{padding:16px!important}
.section{padding-bottom:18px!important;margin-bottom:17px!important}
.section-heading{color:#929bab!important}
select,input[type=text],input[type=number]{
 background:rgba(255,255,255,.045)!important;border-color:rgba(255,255,255,.09)!important;
 box-shadow:inset 0 1px 0 rgba(255,255,255,.025);transition:.18s;
}
select:focus,input[type=text]:focus,input[type=number]:focus{border-color:rgba(124,92,255,.65)!important;box-shadow:0 0 0 3px rgba(124,92,255,.10)}
.button{background:rgba(255,255,255,.045)!important;border-color:rgba(255,255,255,.10)!important}
.button:hover{transform:translateY(-1px);background:rgba(255,255,255,.08)!important}
.button.primary{background:linear-gradient(135deg,#7656ff,#9b75ff)!important;border-color:transparent!important;box-shadow:0 10px 24px rgba(124,92,255,.25)}
.button.light{background:linear-gradient(135deg,#fff,#dfe8ff)!important;color:#0a0c11!important}
.upload{background:linear-gradient(135deg,rgba(124,92,255,.07),rgba(0,212,255,.035));border-color:rgba(154,133,255,.35)!important}
.upload-icon{background:linear-gradient(135deg,#27203f,#102b37)!important;color:#b8adff}
.preset,.pattern-option{box-shadow:inset 0 0 0 1px rgba(255,255,255,.05);transition:.18s}
.preset.active,.pattern-option.active{border-color:#fff!important;box-shadow:0 0 0 2px rgba(124,92,255,.22)}
.canvas-panel{min-height:760px!important;padding:14px!important}
.canvas-toolbar{background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.06);padding:9px;border-radius:13px}
.canvas-wrap{
 min-height:620px!important;border:1px solid rgba(255,255,255,.06);
 background-color:#0c0f15!important;
}
#canvas{box-shadow:0 35px 100px rgba(0,0,0,.62);transition:transform .18s ease}
.studio-toolbar{
 display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;
 margin:0 auto 16px;padding:10px;border:1px solid rgba(255,255,255,.08);
 background:rgba(14,17,24,.72);backdrop-filter:blur(18px);border-radius:16px;box-shadow:0 18px 55px rgba(0,0,0,.22)
}
.tool-group{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.tool-btn{
 height:34px;min-width:34px;padding:0 10px;border-radius:9px;border:1px solid rgba(255,255,255,.09);
 background:rgba(255,255,255,.04);color:#cfd5df;cursor:pointer;font-size:11px;font-weight:700
}
.tool-btn:hover{background:rgba(124,92,255,.13);border-color:rgba(124,92,255,.4);color:#fff}
.tool-btn.active{background:rgba(124,92,255,.18);border-color:rgba(154,133,255,.55);color:#fff}
.zoom-readout{min-width:54px;text-align:center;color:#9ba3b2;font-size:10px;font-weight:800}
.pro-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.control-card{
 padding:10px;border:1px solid rgba(255,255,255,.065);border-radius:12px;
 background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.018))
}
.control-card .label{margin-bottom:6px}
.color-chip-row{display:grid;grid-template-columns:repeat(6,1fr);gap:5px}
.color-chip{height:27px;border-radius:7px;border:1px solid rgba(255,255,255,.14);cursor:pointer}
.section.pro-section{border-bottom:1px solid rgba(255,255,255,.07)}
.mini-note{font-size:9px;color:#687181;line-height:1.55;margin-top:6px}
.canvas-hud{
 position:absolute;left:12px;bottom:12px;z-index:4;display:flex;gap:6px;align-items:center;
 padding:7px 9px;border-radius:10px;background:rgba(5,7,11,.72);backdrop-filter:blur(10px);
 border:1px solid rgba(255,255,255,.08);font-size:9px;color:#9aa3b2;pointer-events:none
}
.canvas-hud b{color:#e7ebf3}
.shortcut{
 padding:3px 6px;border:1px solid rgba(255,255,255,.10);border-radius:5px;background:rgba(255,255,255,.04);font-size:8px
}
.transform-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.transform-grid .control{margin-bottom:0}
@media(max-width:1250px){.editor{grid-template-columns:330px minmax(0,1fr)!important}.right-panel{grid-column:1/-1}.canvas-panel{min-height:690px!important}}
@media(max-width:850px){.editor{display:flex!important;flex-direction:column!important}.canvas-panel{order:1!important;min-height:560px!important}.left-panel{order:2!important}.right-panel{order:3!important}.canvas-wrap{min-height:430px!important}.studio-toolbar{position:static}}
@media(max-width:600px){
 main{width:95%!important}.hero h1{font-size:40px}.studio-toolbar{padding:8px}.tool-btn{flex:1}.canvas-panel{padding:10px!important}
 .pro-grid,.transform-grid{grid-template-columns:1fr}.canvas-wrap{min-height:360px!important}
}


/* =========================================================
   RESPONSIVE LAYOUT FIX — NO OVERLAP / NO HORIZONTAL CROP
   Desktop • Laptop • Tablet • Mobile
========================================================= */
*{box-sizing:border-box}
html,body{width:100%;max-width:100%;overflow-x:hidden}
main,.editor,.workspace,.panel,.canvas-panel,.panel-inner{min-width:0;max-width:100%}

.editor{
  width:100%;
  display:grid;
  grid-template-columns:minmax(300px,365px) minmax(0,1fr) minmax(280px,330px);
  gap:14px;
  align-items:start;
}

.left-panel,.right-panel{
  width:100%;
  min-width:0;
  max-width:100%;
  position:sticky;
  top:84px;
  max-height:calc(100vh - 100px);
  overflow-x:hidden;
  overflow-y:auto;
}

.workspace{width:100%;min-width:0}
.canvas-panel{
  width:100%;
  min-width:0;
  max-width:100%;
  overflow:hidden;
}
.canvas-wrap{
  width:100%;
  max-width:100%;
  min-width:0;
  overflow:auto;
}

.panel-inner{width:100%;overflow:hidden}
.control,.control-card,.section,.pro-grid,.transform-grid,.range-row,.two,
.color-list,.export-name,.text-color-row,.pattern-grid,.preset-grid{min-width:0;max-width:100%}

/* Never allow long controls/labels to force the editor wider */
.label,.section-heading,.mini-note,.panel-title,.upload,strong,small,
.range-value,.image-info{overflow-wrap:anywhere;word-break:normal}
select,input[type=text],input[type=number]{min-width:0;max-width:100%}
input[type=range]{min-width:0;width:100%}

/* ---------- Laptop ---------- */
@media (max-width:1280px){
  main{width:min(1180px,94%)!important}
  .editor{
    grid-template-columns:minmax(290px,330px) minmax(0,1fr);
  }
  .right-panel{
    grid-column:1 / -1;
    position:relative;
    top:auto;
    max-height:none;
    overflow:visible;
  }
  .left-panel{
    position:sticky;
    top:84px;
    max-height:calc(100vh - 100px);
  }
  .pro-grid{grid-template-columns:1fr}
  .transform-grid{grid-template-columns:1fr 1fr}
  .canvas-panel{min-height:680px!important}
  .canvas-wrap{min-height:520px!important}
}

/* ---------- Small laptop / large tablet ---------- */
@media (max-width:1000px){
  main{width:min(94%,900px)!important}
  .editor{
    grid-template-columns:minmax(270px,310px) minmax(0,1fr);
    gap:12px;
  }
  .panel-inner{padding:14px!important}
  .pro-grid,.transform-grid{grid-template-columns:1fr}
  .canvas-panel{min-height:620px!important;padding:12px!important}
  .canvas-wrap{min-height:470px!important}
}

/* ---------- Tablet ---------- */
@media (max-width:820px){
  main{width:min(94%,760px)!important}
  .editor{
    display:flex!important;
    flex-direction:column!important;
    width:100%;
    gap:12px;
  }
  .left-panel,.right-panel{
    position:relative!important;
    top:auto!important;
    width:100%!important;
    max-width:100%!important;
    max-height:none!important;
    overflow:visible!important;
  }
  .canvas-panel{order:1!important;width:100%!important;min-height:600px!important}
  .left-panel{order:2!important}
  .right-panel{order:3!important;grid-column:auto!important}
  .canvas-wrap{min-height:500px!important}
  .pro-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .transform-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}

/* ---------- Mobile ---------- */
@media (max-width:600px){
  main{width:calc(100% - 24px)!important;padding:18px 0 40px!important}
  .editor{display:flex!important;flex-direction:column!important;gap:10px}
  .canvas-panel{order:1!important}
  .left-panel{order:2!important}
  .right-panel{order:3!important}
  .panel,.canvas-panel{border-radius:15px!important}
  .panel-title{padding:14px!important}
  .panel-inner{padding:12px!important}
  .section{padding-bottom:15px!important;margin-bottom:15px!important}
  .pro-grid,.transform-grid{grid-template-columns:1fr}
  .canvas-panel{padding:9px!important;min-height:500px!important}
  .canvas-wrap{min-height:360px!important}
  .canvas-toolbar{flex-wrap:wrap}
  .studio-toolbar{width:100%;gap:7px}
  .tool-group{width:100%}
  .tool-btn{flex:1;min-width:0}
  .format-buttons{flex-wrap:wrap}
  .export-name{display:grid;grid-template-columns:minmax(0,1fr) auto}
  .extension{min-width:58px}
  .upload{padding:20px 12px}
  .hero h1{font-size:clamp(34px,10vw,46px)}
  .hero p{font-size:13px}
}

/* ---------- Very small phones ---------- */
@media (max-width:380px){
  main{width:calc(100% - 16px)!important}
  .panel-inner{padding:10px!important}
  .canvas-wrap{min-height:300px!important}
  .canvas-panel{min-height:430px!important}
  .button{min-height:38px}
}

/* =========================================================
   CREATIVE STUDIO SUITE EXPANSION
========================================================= */
.main-tool-switch{display:flex;align-items:center;gap:4px;flex-wrap:wrap;}
.main-tool-switch .tool-btn{
  font-size:11px;padding:0 10px;height:34px;display:flex;align-items:center;gap:5px;
}
.main-tool-switch .tool-btn.active{
  background:linear-gradient(135deg,#7656ff,#9b75ff)!important;color:#fff!important;
  border-color:transparent!important;box-shadow:0 4px 14px rgba(124,92,255,.35);
}
.tool-btn.highlight{
  background:linear-gradient(135deg,rgba(0,212,255,.14),rgba(124,92,255,.14));
  border-color:rgba(0,212,255,.4);color:#dcf8ff;font-weight:700;
}
.tool-btn.highlight:hover{
  background:linear-gradient(135deg,rgba(0,212,255,.24),rgba(124,92,255,.24));
  border-color:rgba(0,212,255,.7);color:#fff;
}

/* Modal styles */
.modal-backdrop{
  position:fixed;top:0;left:0;right:0;bottom:0;
  background:rgba(0,0,0,.78);backdrop-filter:blur(14px);
  z-index:9999;display:flex;align-items:center;justify-content:center;
  padding:16px;
}
.modal-dialog{
  background:linear-gradient(180deg,rgba(22,26,35,.98),rgba(14,17,23,.98));
  border:1px solid rgba(255,255,255,.14);border-radius:20px;
  box-shadow:0 30px 100px rgba(0,0,0,.85);
  width:min(680px,100%);max-height:90vh;overflow-y:auto;
  display:flex;flex-direction:column;
}
.modal-header{
  padding:18px 22px;border-bottom:1px solid rgba(255,255,255,.08);
  display:flex;align-items:center;justify-content:space-between;
}
.modal-title{font-size:14px;font-weight:800;letter-spacing:.8px;display:flex;align-items:center;gap:8px;}
.modal-close{
  background:transparent;border:none;color:#999;font-size:22px;line-height:1;cursor:pointer;padding:4px;
}
.modal-close:hover{color:#fff;}
.modal-body{padding:20px 22px;overflow-y:auto;}
.modal-footer{
  padding:16px 22px;border-top:1px solid rgba(255,255,255,.08);
  display:flex;justify-content:flex-end;gap:10px;
}
.modal-section-title{
  font-size:10px;font-weight:800;color:var(--accent2);letter-spacing:1.5px;margin-bottom:10px;
}
.modal-preset-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;
}
.preset-card{
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);
  border-radius:10px;padding:10px 12px;text-align:left;cursor:pointer;transition:.18s;
}
.preset-card:hover{background:rgba(124,92,255,.1);border-color:rgba(124,92,255,.35);}
.preset-card.active{background:rgba(124,92,255,.18);border-color:var(--accent);box-shadow:0 0 0 2px rgba(124,92,255,.25);}
.preset-name{font-size:11px;font-weight:700;color:#f0f2f7;margin-bottom:3px;}
.preset-dim{font-size:9px;color:#858d9d;}
.custom-dim-grid{
  display:grid;grid-template-columns:1fr 1fr 1fr 1.3fr;gap:8px;
}
.doc-options-row{
  display:flex;gap:12px;margin-top:12px;
}
.bg-color-pickers{
  display:flex;align-items:center;gap:7px;margin-top:4px;
}
.bg-choice{
  width:28px;height:28px;border-radius:7px;cursor:pointer;border:2px solid transparent;transition:.18s;
}
.bg-choice.active{border-color:var(--accent2);box-shadow:0 0 0 2px rgba(0,212,255,.3);}
.doc-summary-badge{
  margin-top:16px;padding:10px 14px;background:rgba(124,92,255,.08);border:1px solid rgba(124,92,255,.2);
  border-radius:10px;font-size:11px;color:#cfc9f7;text-align:center;
}

/* Right panel tabs & Layers Panel */
.panel-tab-header{
  display:flex;border-bottom:1px solid var(--border);background:rgba(255,255,255,.015);
}
.panel-tab{
  flex:1;padding:13px 10px;background:none;border:none;border-bottom:2px solid transparent;
  color:#8891a0;font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;
  cursor:pointer;display:flex;align-items:center;justify-content:center;gap:6px;transition:.18s;
}
.panel-tab:hover{color:#fff;}
.panel-tab.active{
  color:#fff;border-bottom-color:var(--accent);background:rgba(124,92,255,.07);
}
.layers-customizer{
  background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.07);border-radius:12px;
  padding:12px;margin-bottom:12px;
}
.layers-list{
  display:flex;flex-direction:column;gap:6px;max-height:360px;overflow-y:auto;padding-right:2px;margin-top:8px;
}
.layer-row{
  display:flex;align-items:center;gap:8px;padding:8px 10px;
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);
  border-radius:10px;cursor:pointer;transition:.15s;user-select:none;
}
.layer-row:hover{background:rgba(255,255,255,.06);border-color:rgba(255,255,255,.12);}
.layer-row.active{
  background:rgba(124,92,255,.16);border-color:rgba(124,92,255,.5);
  box-shadow:inset 3px 0 0 var(--accent2);
}
.layer-row.hidden-layer{opacity:.45;}
.layer-eye-btn{
  background:none;border:none;color:#8e96a5;font-size:14px;cursor:pointer;padding:2px 4px;
  border-radius:4px;display:flex;align-items:center;justify-content:center;
}
.layer-eye-btn:hover{color:#fff;background:rgba(255,255,255,.08);}
.layer-type-icon{font-size:13px;min-width:18px;text-align:center;}
.layer-name-wrap{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.layer-name-text{font-size:11px;font-weight:600;color:#e8ebf2;}
.layer-badge{
  font-size:9px;color:#858d9d;padding:2px 5px;background:rgba(255,255,255,.05);border-radius:4px;
}
.layer-del-btn{
  background:none;border:none;color:#6b7280;font-size:12px;cursor:pointer;padding:3px 5px;
  border-radius:4px;transition:.15s;
}
.layer-del-btn:hover{color:var(--danger);background:rgba(255,84,112,.12);}
.layers-toolbar{
  display:flex;gap:4px;flex-wrap:wrap;margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,.07);
}
.layer-btn-mini{
  flex:1;min-width:32px;height:28px;padding:0 6px;font-size:10px;font-weight:700;
  background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);
  border-radius:7px;color:#b2b8c5;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:3px;
}
.layer-btn-mini:hover{background:rgba(124,92,255,.15);border-color:rgba(124,92,255,.4);color:#fff;}

/* Brush Presets Grid */
.brush-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:6px;margin-bottom:12px;
}
.brush-card{
  background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);
  border-radius:9px;padding:8px 10px;cursor:pointer;display:flex;align-items:center;gap:8px;transition:.15s;
}
.brush-card:hover{background:rgba(124,92,255,.08);border-color:rgba(124,92,255,.3);}
.brush-card.active{
  background:rgba(124,92,255,.18);border-color:var(--accent);color:#fff;
  box-shadow:0 0 0 1px var(--accent);
}
.brush-icon{font-size:14px;}
.brush-title{font-size:10px;font-weight:700;}

/* Pen Tool UI */
.pen-modes{
  display:grid;grid-template-columns:repeat(2,1fr);gap:6px;margin-bottom:10px;
}
.pen-mode-btn{
  font-size:10px;padding:7px 8px;border-radius:8px;background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.08);color:#bac0cd;cursor:pointer;font-weight:700;text-align:center;
}
.pen-mode-btn.active{
  background:rgba(124,92,255,.2);border-color:var(--accent);color:#fff;
}
.pen-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;}

/* Creative Effects Studio */
.effect-tabs{
  display:flex;gap:4px;margin-bottom:12px;background:rgba(255,255,255,.02);padding:4px;border-radius:9px;
}
.effect-tab-btn{
  flex:1;padding:7px 4px;font-size:10px;font-weight:700;border:none;background:none;
  border-radius:7px;color:#858e9f;cursor:pointer;transition:.15s;text-align:center;
}
.effect-tab-btn.active{
  background:rgba(124,92,255,.18);color:#fff;
}
.effect-panel-content{display:none;}
.effect-panel-content.active{display:block;}

/* Interactive canvas cursor styles */
.cursor-pen{cursor:crosshair!important;}
.cursor-brush{cursor:crosshair!important;}
.cursor-text{cursor:text!important;}
.cursor-eraser{cursor:cell!important;}

</style>
</head>

<body>

<header>

    <div class="logo">
        ART<span>FORGE</span>
    </div>

    <div class="header-right">
        <button class="button primary" id="headerNewDocBtn" style="height:36px;padding:0 14px;font-size:11px;font-weight:700;display:flex;align-items:center;gap:6px;cursor:pointer;">
            <span style="font-size:14px;">✦</span> New Canvas
        </button>
        <div class="badge">
            BROWSER ART STUDIO
        </div>
    </div>

</header>


<main>

<section class="hero">

    <div class="eyebrow">
        PROFESSIONAL IMAGE ARTWORK EDITOR MADE BY ABDULLAH FORHAD
    </div>

    <h1>
        Create Your Artwork.
    </h1>

    <p>
        Add gradients, typography, patterns and textures to your image.
        Build your artwork directly in your browser and export the final design.
    </p>

</section>



<!-- PRO STUDIO COMMAND BAR -->
<div class="studio-toolbar" id="studioToolbar">
  <div class="tool-group">
    <button class="tool-btn highlight" id="toolbarNewDocBtn" title="Create New Page with Real Sizing">✦ + New Canvas</button>
  </div>
  <div class="tool-group main-tool-switch" id="mainToolSwitch">
    <button class="tool-btn active" data-tool="select" title="Select / Move (V)">↖ Select</button>
    <button class="tool-btn" data-tool="pen" title="Photoshop Pen Tool (P)">✒ Pen Tool</button>
    <button class="tool-btn" data-tool="brush" title="Creative Brushes (B)">🖌 Brush</button>
    <button class="tool-btn" data-tool="text" title="Text Tool (T)">T Text</button>
    <button class="tool-btn" data-tool="eraser" title="Eraser Tool (E)">⌫ Eraser</button>
  </div>
  <div class="tool-group">
    <button class="tool-btn" id="undoBtn" title="Undo (Ctrl/Cmd+Z)">↶ Undo</button>
    <button class="tool-btn" id="redoBtn" title="Redo (Ctrl/Cmd+Shift+Z)">Redo ↷</button>
    <button class="tool-btn" id="fitBtn">Fit</button>
    <button class="tool-btn" id="actualBtn">100%</button>
  </div>
  <div class="tool-group">
    <button class="tool-btn" id="zoomOut">−</button>
    <span class="zoom-readout" id="zoomReadout">100%</span>
    <button class="tool-btn" id="zoomIn">+</button>
    <button class="tool-btn" id="fullscreenBtn">⛶</button>
  </div>
  <div class="tool-group">
    <button class="tool-btn active" id="liveRenderBtn">● Live</button>
    <button class="tool-btn" id="beforeAfterBtn">Before</button>
    <span class="shortcut">Space = compare</span>
  </div>
</div>

<div class="editor">


<!-- ======================================================
     LEFT PANEL
====================================================== -->

<aside class="panel left-panel">

    <div class="panel-title">
        Artwork Controls
    </div>

    <div class="panel-inner">


        <!-- CANVAS & DOCUMENT SETUP -->

        <div class="section">

            <div class="section-heading">
                01 — Canvas & Document
            </div>

            <label class="upload" id="uploadBox" style="margin-bottom:10px;">

                <div class="upload-icon">
                    ＋
                </div>

                <strong>
                    Upload Artwork
                </strong>

                <small>
                    JPG · PNG · WebP
                </small>

                <input
                    type="file"
                    id="fileInput"
                    accept="image/jpeg,image/png,image/webp"
                >

            </label>

            <button class="button primary full" id="sideNewDocBtn" style="padding:12px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:7px;cursor:pointer;">
                <span style="font-size:15px;color:#fff;">✦</span> Make New White Page (Real Sizing)
            </button>

        </div>


        <!-- PHOTOSHOP CS6 PEN TOOL -->
        <div class="section" id="penToolSection">
            <div class="section-heading">
                02 — Photoshop CS6 Pen Tool
            </div>

            <div class="mini-note" style="margin-bottom:9px;color:#9aa3b2;">
                Click canvas to place anchor points. Drag to extract smooth Bézier handles. Click near the start to close path.
            </div>

            <div class="pen-modes">
              <button class="pen-mode-btn active" data-penmode="draw" id="penModeDrawBtn">✒ Pen Draw</button>
              <button class="pen-mode-btn" data-penmode="convert" id="penModeConvertBtn">⌒ Convert Point</button>
            </div>

            <div class="control-card">
              <div class="control">
                <label class="label">Stroke Width</label>
                <div class="range-row">
                  <input type="range" id="penStrokeWidth" min="1" max="50" value="4">
                  <span class="range-value" id="penStrokeWidthValue">4px</span>
                </div>
              </div>

              <div class="control">
                <label class="label">Stroke Color</label>
                <div class="text-color-row">
                  <input type="color" class="text-color" id="penStrokeColor" value="#00d4ff">
                  <input type="text" id="penStrokeHex" value="#00d4ff">
                </div>
              </div>

              <div class="control">
                <label class="label">Fill Color</label>
                <div style="display:flex;gap:7px;align-items:center;margin-bottom:6px;">
                  <label style="display:flex;align-items:center;gap:5px;font-size:11px;cursor:pointer;">
                    <input type="checkbox" id="penFillEnabled"> Enable Fill
                  </label>
                </div>
                <div class="text-color-row" id="penFillColorRow" style="display:none;">
                  <input type="color" class="text-color" id="penFillColor" value="#7656ff">
                  <input type="text" id="penFillHex" value="#7656ff">
                </div>
              </div>

              <div class="control">
                <label class="label">Stroke Style</label>
                <select id="penStrokeStyle">
                  <option value="solid">Solid Line</option>
                  <option value="dashed">Dashed Line</option>
                  <option value="dotted">Dotted Line</option>
                </select>
              </div>

              <div class="pen-actions">
                <button class="button primary full" id="commitPenPathBtn" style="font-weight:700;">
                  ✓ Save as Vector Layer
                </button>
                <div class="two" style="width:100%;margin-top:4px;">
                  <button class="button" id="closePenPathBtn">Close Path</button>
                  <button class="button" id="clearPenPathBtn" style="color:var(--danger);">Clear Path</button>
                </div>
              </div>
            </div>
        </div>


        <!-- ARTISTIC BRUSH STUDIO -->
        <div class="section" id="brushToolSection">
            <div class="section-heading">
                03 — Creative Brush Studio
            </div>

            <div class="label" style="margin-bottom:6px;">Brush Presets</div>
            <div class="brush-grid" id="brushPresets">
                <div class="brush-card active" data-brush="soft-round">
                    <span class="brush-icon">⚪</span>
                    <span class="brush-title">Soft Round</span>
                </div>
                <div class="brush-card" data-brush="hard-round">
                    <span class="brush-icon">⚫</span>
                    <span class="brush-title">Hard Round</span>
                </div>
                <div class="brush-card" data-brush="airbrush">
                    <span class="brush-icon">💨</span>
                    <span class="brush-title">Airbrush</span>
                </div>
                <div class="brush-card" data-brush="calligraphy">
                    <span class="brush-icon">✒️</span>
                    <span class="brush-title">Calligraphy</span>
                </div>
                <div class="brush-card" data-brush="sparkle">
                    <span class="brush-icon">✨</span>
                    <span class="brush-title">Star Sparkle</span>
                </div>
                <div class="brush-card" data-brush="cloud-brush">
                    <span class="brush-icon">☁️</span>
                    <span class="brush-title">Cloud / Mist</span>
                </div>
                <div class="brush-card" data-brush="neon-glow">
                    <span class="brush-icon">💡</span>
                    <span class="brush-title">Neon Glow</span>
                </div>
                <div class="brush-card" data-brush="eraser">
                    <span class="brush-icon">⌫</span>
                    <span class="brush-title">Eraser</span>
                </div>
            </div>

            <div class="control-card">
                <div class="control">
                    <label class="label">Brush Size</label>
                    <div class="range-row">
                        <input type="range" id="brushSize" min="1" max="200" value="28">
                        <span class="range-value" id="brushSizeValue">28px</span>
                    </div>
                </div>

                <div class="control">
                    <label class="label">Brush Opacity</label>
                    <div class="range-row">
                        <input type="range" id="brushOpacity" min="1" max="100" value="100">
                        <span class="range-value" id="brushOpacityValue">100%</span>
                    </div>
                </div>

                <div class="control">
                    <label class="label">Flow / Hardness</label>
                    <div class="range-row">
                        <input type="range" id="brushFlow" min="5" max="100" value="80">
                        <span class="range-value" id="brushFlowValue">80%</span>
                    </div>
                </div>

                <div class="control">
                    <label class="label">Brush Color</label>
                    <div class="text-color-row">
                        <input type="color" class="text-color" id="brushColor" value="#ff3545">
                        <input type="text" id="brushHex" value="#ff3545">
                    </div>
                </div>

                <div class="control" style="margin-bottom:6px;">
                    <label class="label">Quick Swatches</label>
                    <div class="color-chip-row">
                        <div class="color-chip" style="background:#ffffff;" data-chip="#ffffff"></div>
                        <div class="color-chip" style="background:#00d4ff;" data-chip="#00d4ff"></div>
                        <div class="color-chip" style="background:#7c5cff;" data-chip="#7c5cff"></div>
                        <div class="color-chip" style="background:#ff3545;" data-chip="#ff3545"></div>
                        <div class="color-chip" style="background:#ffb703;" data-chip="#ffb703"></div>
                        <div class="color-chip" style="background:#06d6a0;" data-chip="#06d6a0"></div>
                    </div>
                </div>

                <div class="control">
                    <label class="label">Blend Mode</label>
                    <select id="brushBlendMode">
                        <option value="source-over">Normal</option>
                        <option value="screen">Screen</option>
                        <option value="multiply">Multiply</option>
                        <option value="overlay">Overlay</option>
                        <option value="lighter">Lighter / Add</option>
                    </select>
                </div>

                <button class="button full" id="clearDrawingLayerBtn" style="margin-top:6px;font-size:11px;">
                    Clear Current Paint Layer
                </button>
            </div>
        </div>


        <!-- CREATIVE EFFECTS STUDIO (WATERMARK, CLOUDS, MOON) -->
        <div class="section" id="creativeEffectsSection">
            <div class="section-heading">
                04 — Creative Effects Studio
            </div>

            <div class="effect-tabs">
                <button class="effect-tab-btn active" data-effecttab="watermark">💧 Watermark</button>
                <button class="effect-tab-btn" data-effecttab="clouds">☁️ Clouds</button>
                <button class="effect-tab-btn" data-effecttab="moon">🌕 Moon</button>
            </div>

            <!-- WATERMARK EFFECT -->
            <div class="effect-panel-content active" id="effectWatermarkPanel">
                <div class="control-card">
                    <div class="control">
                        <label class="label">Watermark Text</label>
                        <input type="text" id="watermarkText" value="© ARTFORGE STUDIO">
                    </div>

                    <div class="control">
                        <label class="label">Layout Style</label>
                        <select id="watermarkLayout">
                            <option value="tiled">Repeating Diagonal Grid (Copyright Protection)</option>
                            <option value="bottom-right">Bottom Right Corner</option>
                            <option value="center">Center Stamp</option>
                            <option value="bottom-center">Bottom Center</option>
                        </select>
                    </div>

                    <div class="control">
                        <label class="label">Opacity</label>
                        <div class="range-row">
                            <input type="range" id="watermarkOpacity" min="5" max="100" value="28">
                            <span class="range-value" id="watermarkOpacityValue">28%</span>
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Font Size</label>
                        <div class="range-row">
                            <input type="range" id="watermarkFontSize" min="12" max="90" value="26">
                            <span class="range-value" id="watermarkFontSizeValue">26px</span>
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Rotation Angle</label>
                        <div class="range-row">
                            <input type="range" id="watermarkAngle" min="-60" max="60" value="-30">
                            <span class="range-value" id="watermarkAngleValue">-30°</span>
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Color</label>
                        <div class="text-color-row">
                            <input type="color" class="text-color" id="watermarkColor" value="#ffffff">
                            <input type="text" id="watermarkHex" value="#ffffff">
                        </div>
                    </div>

                    <button class="button primary full" id="addWatermarkLayerBtn" style="margin-top:6px;font-weight:700;">
                        + Add Watermark Layer
                    </button>
                </div>
            </div>

            <!-- CLOUD EFFECT -->
            <div class="effect-panel-content" id="effectCloudsPanel">
                <div class="control-card">
                    <div class="control">
                        <label class="label">Cloud Style</label>
                        <select id="cloudStyle">
                            <option value="cumulus">Fluffy Cumulus Clouds</option>
                            <option value="storm">Dramatic Thunder Storm</option>
                            <option value="mist">Morning Horizon Mist / Fog</option>
                            <option value="sunset">Sunset Golden Clouds</option>
                        </select>
                    </div>

                    <div class="control">
                        <label class="label">Cloud Density</label>
                        <div class="range-row">
                            <input type="range" id="cloudDensity" min="10" max="100" value="65">
                            <span class="range-value" id="cloudDensityValue">65%</span>
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Puffiness / Scale</label>
                        <div class="range-row">
                            <input type="range" id="cloudScale" min="20" max="150" value="60">
                            <span class="range-value" id="cloudScaleValue">60</span>
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Coverage Area</label>
                        <select id="cloudCoverage">
                            <option value="full">Full Canvas</option>
                            <option value="top">Sky (Top 55%)</option>
                            <option value="bottom">Horizon / Ground (Bottom 45%)</option>
                        </select>
                    </div>

                    <div class="control">
                        <label class="label">Cloud Tint Color</label>
                        <div class="text-color-row">
                            <input type="color" class="text-color" id="cloudColor" value="#ffffff">
                            <input type="text" id="cloudHex" value="#ffffff">
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Cloud Opacity</label>
                        <div class="range-row">
                            <input type="range" id="cloudOpacity" min="10" max="100" value="75">
                            <span class="range-value" id="cloudOpacityValue">75%</span>
                        </div>
                    </div>

                    <div class="two" style="margin-top:6px;">
                        <button class="button" id="rerollCloudsBtn">🎲 Re-roll Seed</button>
                        <button class="button primary" id="addCloudsLayerBtn">+ Add Clouds Layer</button>
                    </div>
                </div>
            </div>

            <!-- MOON EFFECT -->
            <div class="effect-panel-content" id="effectMoonPanel">
                <div class="control-card">
                    <div class="control">
                        <label class="label">Moon Phase</label>
                        <select id="moonPhase">
                            <option value="full">🌕 Full Moon (Luminous)</option>
                            <option value="gibbous">🌖 Waxing Gibbous</option>
                            <option value="quarter">🌓 First Quarter (50%)</option>
                            <option value="crescent">🌙 Crescent Moon</option>
                            <option value="blood">🌑 Blood Moon (Crimson Eclipse)</option>
                            <option value="cyber">🛸 Cyber Neon Moon</option>
                        </select>
                    </div>

                    <div class="control">
                        <label class="label">Moon Size</label>
                        <div class="range-row">
                            <input type="range" id="moonSize" min="30" max="400" value="130">
                            <span class="range-value" id="moonSizeValue">130px</span>
                        </div>
                    </div>

                    <div class="transform-grid">
                        <div class="control">
                            <label class="label">Position X</label>
                            <div class="range-row">
                                <input type="range" id="moonX" min="0" max="100" value="75">
                                <span class="range-value" id="moonXValue">75%</span>
                            </div>
                        </div>
                        <div class="control">
                            <label class="label">Position Y</label>
                            <div class="range-row">
                                <input type="range" id="moonY" min="0" max="100" value="28">
                                <span class="range-value" id="moonYValue">28%</span>
                            </div>
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Corona Glow / Halo Radius</label>
                        <div class="range-row">
                            <input type="range" id="moonGlowRadius" min="0" max="180" value="70">
                            <span class="range-value" id="moonGlowRadiusValue">70px</span>
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Glow Tint Color</label>
                        <div class="text-color-row">
                            <input type="color" class="text-color" id="moonGlowColor" value="#cbe5ff">
                            <input type="text" id="moonGlowHex" value="#cbe5ff">
                        </div>
                    </div>

                    <div class="control">
                        <label class="label">Surface Craters & Maria</label>
                        <select id="moonSurfaceDetail">
                            <option value="textured">Realistic Craters & Seas</option>
                            <option value="smooth">Smooth Graphic Glow</option>
                        </select>
                    </div>

                    <div class="control">
                        <label class="label">Moon Opacity</label>
                        <div class="range-row">
                            <input type="range" id="moonOpacity" min="10" max="100" value="95">
                            <span class="range-value" id="moonOpacityValue">95%</span>
                        </div>
                    </div>

                    <button class="button primary full" id="addMoonLayerBtn" style="margin-top:6px;font-weight:700;">
                        + Add Moon Layer
                    </button>
                </div>
            </div>
        </div>



        <!-- PRO IMAGE LAB -->
        <div class="section pro-section">
          <div class="section-heading">02 — Pro Image Lab</div>

          <div class="pro-grid">
            <div class="control-card">
              <label class="label">Image Opacity</label>
              <div class="range-row"><input type="range" id="imageOpacity" min="0" max="100" value="100"><span class="range-value" id="imageOpacityValue">100%</span></div>
            </div>
            <div class="control-card">
              <label class="label">Hue Shift</label>
              <div class="range-row"><input type="range" id="hueRotate" min="-180" max="180" value="0"><span class="range-value" id="hueRotateValue">0°</span></div>
            </div>
            <div class="control-card">
              <label class="label">Grayscale</label>
              <div class="range-row"><input type="range" id="grayscale" min="0" max="100" value="0"><span class="range-value" id="grayscaleValue">0%</span></div>
            </div>
            <div class="control-card">
              <label class="label">Sepia</label>
              <div class="range-row"><input type="range" id="sepia" min="0" max="100" value="0"><span class="range-value" id="sepiaValue">0%</span></div>
            </div>
          </div>

          <div class="control-card" style="margin-top:8px">
            <label class="label">Transform</label>
            <div class="transform-grid">
              <div class="control"><label class="label">Rotation</label><div class="range-row"><input type="range" id="rotate" min="-180" max="180" value="0"><span class="range-value" id="rotateValue">0°</span></div></div>
              <div class="control"><label class="label">Scale</label><div class="range-row"><input type="range" id="scale" min="50" max="150" value="100"><span class="range-value" id="scaleValue">100%</span></div></div>
              <div class="control"><label class="label">Position X</label><div class="range-row"><input type="range" id="imageX" min="-100" max="100" value="0"><span class="range-value" id="imageXValue">0</span></div></div>
              <div class="control"><label class="label">Position Y</label><div class="range-row"><input type="range" id="imageY" min="-100" max="100" value="0"><span class="range-value" id="imageYValue">0</span></div></div>
            </div>
            <div class="two" style="margin-top:8px">
              <button class="button" id="flipH">↔ Flip H</button>
              <button class="button" id="flipV">↕ Flip V</button>
            </div>
          </div>

          <div class="control-card" style="margin-top:8px">
            <label class="label">Artwork Frame</label>
            <div class="transform-grid">
              <div class="control"><label class="label">Corner Radius</label><div class="range-row"><input type="range" id="cornerRadius" min="0" max="80" value="0"><span class="range-value" id="cornerRadiusValue">0px</span></div></div>
              <div class="control"><label class="label">Border Width</label><div class="range-row"><input type="range" id="borderWidth" min="0" max="40" value="0"><span class="range-value" id="borderWidthValue">0px</span></div></div>
            </div>
            <div class="text-color-row" style="margin-top:8px">
              <input type="color" id="borderColor" class="text-color" value="#ffffff">
              <input type="text" id="borderHex" value="#ffffff">
            </div>
            <div class="mini-note">Frame effects are rendered into the exported artwork.</div>
          </div>
        </div>

        <!-- GRADIENT -->

        <div class="section">

            <div class="section-heading">
                03 — Gradient
            </div>

            <div class="control">

                <label class="label">
                    Gradient Type
                </label>

                <select id="gradientType">

                    <option value="linear">
                        Linear
                    </option>

                    <option value="radial">
                        Radial
                    </option>

                    <option value="conic">
                        Conic
                    </option>

                </select>

            </div>


            <div class="control">

                <label class="label">
                    Colors
                </label>

                <div class="color-list" id="colorList"></div>

                <button
                    class="add-btn"
                    id="addColor">
                    + Add Color
                </button>

            </div>


            <div class="control">

                <label class="label">
                    Angle
                </label>

                <div class="range-row">

                    <input
                        type="range"
                        id="angle"
                        min="0"
                        max="360"
                        value="135">

                    <span
                        class="range-value"
                        id="angleValue">
                        135°
                    </span>

                </div>

            </div>


            <div class="control">

                <label class="label">
                    Opacity
                </label>

                <div class="range-row">

                    <input
                        type="range"
                        id="gradientOpacity"
                        min="0"
                        max="100"
                        value="70">

                    <span
                        class="range-value"
                        id="gradientOpacityValue">
                        70%
                    </span>

                </div>

            </div>


            <div class="control">

                <label class="label">
                    Blend Mode
                </label>

                <select id="gradientBlend">

                    <option value="source-over">
                        Normal
                    </option>

                    <option value="multiply">
                        Multiply
                    </option>

                    <option value="screen">
                        Screen
                    </option>

                    <option value="overlay">
                        Overlay
                    </option>

                    <option value="soft-light">
                        Soft Light
                    </option>

                    <option value="hard-light">
                        Hard Light
                    </option>

                    <option value="color-dodge">
                        Color Dodge
                    </option>

                    <option value="color-burn">
                        Color Burn
                    </option>

                    <option value="difference">
                        Difference
                    </option>

                </select>

            </div>


            <div class="preset-grid">

                <button
                    class="preset"
                    data-colors="#ff0055,#7b00ff"
                    style="background:linear-gradient(135deg,#ff0055,#7b00ff)">
                </button>

                <button
                    class="preset"
                    data-colors="#00c6ff,#0072ff"
                    style="background:linear-gradient(135deg,#00c6ff,#0072ff)">
                </button>

                <button
                    class="preset"
                    data-colors="#f7971e,#ffd200"
                    style="background:linear-gradient(135deg,#f7971e,#ffd200)">
                </button>

                <button
                    class="preset"
                    data-colors="#00f260,#0575e6"
                    style="background:linear-gradient(135deg,#00f260,#0575e6)">
                </button>

                <button
                    class="preset"
                    data-colors="#ff512f,#dd2476"
                    style="background:linear-gradient(135deg,#ff512f,#dd2476)">
                </button>

                <button
                    class="preset"
                    data-colors="#833ab4,#fd1d1d,#fcb045"
                    style="background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045)">
                </button>

                <button
                    class="preset"
                    data-colors="#141e30,#243b55"
                    style="background:linear-gradient(135deg,#141e30,#243b55)">
                </button>

                <button
                    class="preset"
                    data-colors="#000000,#c1121f"
                    style="background:linear-gradient(135deg,#000,#c1121f)">
                </button>

            </div>

        </div>


        <!-- TEXT -->

        <div class="section">

            <div class="section-heading">
                04 — Typography
            </div>

            <div class="text-add">

                <input
                    type="text"
                    id="textInput"
                    placeholder="Write your text...">

                <button
                    class="button primary"
                    id="addText">
                    +
                </button>

            </div>


            <div
                class="layers"
                id="textLayers">
            </div>


            <div
                id="textControls"
                style="display:none;margin-top:13px;">


                <div class="control">

                    <label class="label">
                        Font
                    </label>

                    <select id="fontFamily">

                        <option value="Inter">
                            Inter
                        </option>

                        <option value="Playfair Display">
                            Playfair Display
                        </option>

                        <option value="Montserrat">
                            Montserrat
                        </option>

                        <option value="Pacifico">
                            Pacifico (Cursive)
                        </option>

                        <option value="Orbitron">
                            Orbitron (Sci-Fi / Modern)
                        </option>

                        <option value="Caveat">
                            Caveat (Handwriting)
                        </option>

                        <option value="Bangers">
                            Bangers (Comic / Display)
                        </option>

                        <option value="Cinzel">
                            Cinzel (Classical Elegant)
                        </option>

                        <option value="Roboto Mono">
                            Roboto Mono
                        </option>

                        <option value="Arial">
                            Arial
                        </option>

                        <option value="Helvetica">
                            Helvetica
                        </option>

                        <option value="Georgia">
                            Georgia
                        </option>

                        <option value="Times New Roman">
                            Times New Roman
                        </option>

                        <option value="Courier New">
                            Courier New
                        </option>

                        <option value="Impact">
                            Impact
                        </option>

                        <option value="Trebuchet MS">
                            Trebuchet MS
                        </option>

                        <option value="Verdana">
                            Verdana
                        </option>

                    </select>

                </div>


                <div class="control">

                    <label class="label">
                        Size
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="fontSize"
                            min="10"
                            max="500"
                            value="90">

                        <span
                            class="range-value"
                            id="fontSizeValue">
                            90
                        </span>

                    </div>

                </div>


                <!-- CURVED / ARC TEXT -->
                <div class="control">

                    <label class="label">
                        Curved / Arc Angle (Bending)
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="textArc"
                            min="-180"
                            max="180"
                            value="0">

                        <span
                            class="range-value"
                            id="textArcValue">
                            0°
                        </span>

                    </div>

                </div>


                <div class="control">

                    <label class="label">
                        Horizontal Position
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="textX"
                            min="0"
                            max="100"
                            value="50">

                        <span
                            class="range-value"
                            id="textXValue">
                            50%
                        </span>

                    </div>

                </div>


                <div class="control">

                    <label class="label">
                        Vertical Position
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="textY"
                            min="0"
                            max="100"
                            value="50">

                        <span
                            class="range-value"
                            id="textYValue">
                            50%
                        </span>

                    </div>

                </div>


                <div class="control">

                    <label class="label">
                        Letter Spacing
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="letterSpacing"
                            min="-20"
                            max="50"
                            value="0">

                        <span
                            class="range-value"
                            id="letterSpacingValue">
                            0
                        </span>

                    </div>

                </div>


                <div class="control">

                    <label class="label">
                        Text Opacity
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="textOpacity"
                            min="0"
                            max="100"
                            value="100">

                        <span
                            class="range-value"
                            id="textOpacityValue">
                            100%
                        </span>

                    </div>

                </div>


                <div class="control">

                    <label class="label">
                        Text Color
                    </label>

                    <div class="text-color-row">

                        <input
                            type="color"
                            class="text-color"
                            id="textColor"
                            value="#ffffff">

                        <input
                            type="text"
                            id="textHex"
                            value="#ffffff">

                    </div>

                </div>


                <div class="control">

                    <label class="label">
                        Shadow Blur
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="textShadow"
                            min="0"
                            max="50"
                            value="0">

                        <span
                            class="range-value"
                            id="textShadowValue">
                            0
                        </span>

                    </div>

                </div>


                <div class="control">

                    <label class="label">
