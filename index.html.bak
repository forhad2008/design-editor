  document.getElementById("moonSizeValue").textContent = e.target.value + "px";
});
document.getElementById("moonX")?.addEventListener("input", e=>{
  document.getElementById("moonXValue").textContent = e.target.value + "%";
});
document.getElementById("moonY")?.addEventListener("input", e=>{
  document.getElementById("moonYValue").textContent = e.target.value + "%";
});
document.getElementById("moonGlowRadius")?.addEventListener("input", e=>{
  document.getElementById("moonGlowRadiusValue").textContent = e.target.value + "px";
});
document.getElementById("moonGlowColor")?.addEventListener("input", e=>{
  document.getElementById("moonGlowHex").value = e.target.value;
});
document.getElementById("moonOpacity")?.addEventListener("input", e=>{
  document.getElementById("moonOpacityValue").textContent = e.target.value + "%";
});

document.getElementById("addMoonLayerBtn")?.addEventListener("click", ()=>{
  const mLayer = {
    id: "layer-moon-" + Date.now(),
    name: "Celestial Moon",
    type: "effect-moon",
    visible: true,
    opacity: 100,
    blendMode: "source-over",
    locked: false,
    data: {
      phase: document.getElementById("moonPhase").value,
      size: Number(document.getElementById("moonSize").value) || 130,
      x: Number(document.getElementById("moonX").value) || 75,
      y: Number(document.getElementById("moonY").value) || 28,
      glowRadius: Number(document.getElementById("moonGlowRadius").value) || 70,
      glowColor: document.getElementById("moonGlowColor").value || "#cbe5ff",
      detail: document.getElementById("moonSurfaceDetail").value,
      opacity: Number(document.getElementById("moonOpacity").value) || 95
    }
  };
  layers.push(mLayer);
  activeLayerId = mLayer.id;
  renderLayersUI();
  render();
  pushHistory();
});

function drawMoonLayer(layerData){
  const w = canvas.width, h = canvas.height;
  const phase = layerData.phase || "full";
  const size = layerData.size || 130;
  const x = w * (layerData.x / 100);
  const y = h * (layerData.y / 100);
  const glowRadius = layerData.glowRadius || 70;
  const glowColor = layerData.glowColor || "#cbe5ff";
  const detail = layerData.detail || "textured";
  const opacity = (layerData.opacity || 95) / 100;

  ctx.save();
  ctx.globalAlpha = opacity;

  // 1. Lunar Corona Glow
  if(glowRadius > 0){
    const halo = ctx.createRadialGradient(x, y, size * 0.4, x, y, size + glowRadius);
    halo.addColorStop(0, glowColor);
    halo.addColorStop(0.3, glowColor);
    halo.addColorStop(1, "transparent");
    ctx.save();
    ctx.globalAlpha = opacity * 0.55;
    ctx.globalCompositeOperation = "screen";
    ctx.beginPath();
    ctx.arc(x, y, size + glowRadius, 0, Math.PI * 2);
    ctx.fillStyle = halo;
    ctx.fill();
    ctx.restore();
  }

  // 2. Moon Body & Clip
  ctx.save();
  ctx.beginPath();
  ctx.arc(x, y, size, 0, Math.PI * 2);
  ctx.clip();

  if(phase === "blood"){
    const bloodGrad = ctx.createRadialGradient(x - size * 0.3, y - size * 0.3, 0, x, y, size);
    bloodGrad.addColorStop(0, "#ff5533");
    bloodGrad.addColorStop(0.7, "#991111");
    bloodGrad.addColorStop(1, "#3a0505");
    ctx.fillStyle = bloodGrad;
    ctx.fill();
  } else if(phase === "cyber"){
    const cyberGrad = ctx.createLinearGradient(x - size, y - size, x + size, y + size);
    cyberGrad.addColorStop(0, "#00f2fe");
    cyberGrad.addColorStop(1, "#4facfe");
    ctx.fillStyle = cyberGrad;
    ctx.fill();
  } else {
    const moonGrad = ctx.createRadialGradient(x - size * 0.3, y - size * 0.3, size * 0.1, x, y, size);
    moonGrad.addColorStop(0, "#ffffff");
    moonGrad.addColorStop(0.6, "#e8eaf0");
    moonGrad.addColorStop(1, "#c0c5d0");
    ctx.fillStyle = moonGrad;
    ctx.fill();
  }

  // 3. Lunar Craters & Maria
  if(detail === "textured" && phase !== "cyber"){
    ctx.save();
    ctx.fillStyle = (phase === "blood") ? "rgba(60,0,0,0.35)" : "rgba(80,85,100,0.22)";
    const maria = [
      { ox: -0.2, oy: -0.25, rx: 0.35, ry: 0.25, rot: 0.3 },
      { ox: 0.25, oy: -0.15, rx: 0.3, ry: 0.35, rot: -0.2 },
      { ox: -0.1, oy: 0.2, rx: 0.4, ry: 0.3, rot: 0.5 },
      { ox: 0.15, oy: 0.3, rx: 0.25, ry: 0.25, rot: 0 }
    ];
    maria.forEach(m=>{
      ctx.beginPath();
      ctx.ellipse(x + m.ox * size, y + m.oy * size, m.rx * size, m.ry * size, m.rot, 0, Math.PI * 2);
      ctx.fill();
    });

    const craters = [
      { ox: -0.4, oy: 0.1, r: 0.12 },
      { ox: 0.35, oy: 0.35, r: 0.1 },
      { ox: -0.1, oy: -0.5, r: 0.08 },
      { ox: 0.1, oy: 0.05, r: 0.07 },
      { ox: -0.3, oy: 0.4, r: 0.09 }
    ];
    craters.forEach(c=>{
      ctx.beginPath();
      ctx.arc(x + c.ox * size, y + c.oy * size, c.r * size, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(70,75,90,0.28)";
      ctx.fill();
      ctx.lineWidth = 1.5;
      ctx.strokeStyle = "rgba(255,255,255,0.4)";
      ctx.stroke();
    });
    ctx.restore();
  }

  // 4. Lunar Phases Shadow Mask
  if(phase === "crescent" || phase === "quarter" || phase === "gibbous"){
    ctx.save();
    let shadowK = 0;
    if(phase === "crescent") shadowK = 0.55;
    else if(phase === "quarter") shadowK = 0.0;
    else if(phase === "gibbous") shadowK = -0.5;

    ctx.fillStyle = "rgba(6,8,14,0.92)";
    ctx.beginPath();
    ctx.arc(x, y, size + 1, Math.PI * 0.5, Math.PI * 1.5);
    ctx.ellipse(x, y, size * shadowK, size + 1, 0, Math.PI * 1.5, Math.PI * 0.5, shadowK < 0);
    ctx.fill();
    ctx.restore();
  }

  ctx.restore();
  ctx.restore();
}

/* ---------------------------------------------------------
   INTERACTION CANVAS POINTER EVENTS (PEN & BRUSH)
--------------------------------------------------------- */
function getCanvasCoords(e){
  const target = interactionCanvas || canvas;
  const rect = target.getBoundingClientRect();
  const scaleX = canvas.width / rect.width;
  const scaleY = canvas.height / rect.height;
  return {
    x: (e.clientX - rect.left) * scaleX,
    y: (e.clientY - rect.top) * scaleY
  };
}

function clearInteractionOverlay(){
  if(interactionCtx && interactionCanvas){
    interactionCtx.clearRect(0, 0, interactionCanvas.width, interactionCanvas.height);
  }
}

if(interactionCanvas){
  interactionCanvas.addEventListener("pointerdown", e=>{
    const { x, y } = getCanvasCoords(e);

    if(activeTool === "pen"){
      if(activePenPath.points.length > 2){
        const first = activePenPath.points[0];
        const dist = Math.hypot(first.x - x, first.y - y);
        if(dist < 16){
          activePenPath.isClosed = true;
          redrawPenOverlay();
          return;
        }
      }
      activePenPath.isClosed = false;
      const newPt = { x, y, handleIn: { x, y }, handleOut: { x, y } };
      activePenPath.points.push(newPt);
      activeAnchorIndex = activePenPath.points.length - 1;
      isDraggingPenHandle = true;
      redrawPenOverlay();
    } else if(activeTool === "brush" || activeTool === "eraser"){
      const pLayer = getOrCreateActivePaintLayer();
      if(!pLayer) return;
      isDrawing = true;
      lastBrushPt = { x, y };
      const bSize = Number(document.getElementById("brushSize").value) || 28;
      const bOpacity = Number(document.getElementById("brushOpacity").value) || 100;
      const bFlow = Number(document.getElementById("brushFlow").value) || 80;
      const bColor = document.getElementById("brushColor").value || "#ff3545";

      drawBrushDab(pLayer.ctx, x, y, (activeTool === "eraser" ? "eraser" : currentBrush), bSize, bOpacity, bFlow, bColor);
      render();
    } else if(activeTool === "text"){
      const textX = Math.round((x / canvas.width) * 100);
      const textY = Math.round((y / canvas.height) * 100);
      const inp = document.getElementById("textInput");
      const val = inp?.value.trim() || "Creative Typography";
      const count = layers.filter(l => l.type === "text").length + 1;
      const newL = {
        id: "layer-text-" + Date.now(),
        name: "Text " + count,
        type: "text",
        visible: true,
        opacity: 100,
        blendMode: "source-over",
        locked: false,
        data: {
          text: val,
          font: document.getElementById("fontFamily")?.value || "Inter",
          size: Number(document.getElementById("fontSize")?.value) || 80,
          weight: "700",
          x: textX,
          y: textY,
          color: document.getElementById("textColor")?.value || "#ffffff",
          opacity: 1,
          letterSpacing: Number(document.getElementById("letterSpacing")?.value) || 0,
          shadow: Number(document.getElementById("textShadow")?.value) || 0,
          stroke: Number(document.getElementById("textStroke")?.value) || 0,
          strokeColor: document.getElementById("textStrokeColor")?.value || "#000000",
          arc: Number(document.getElementById("textArc")?.value) || 0
        }
      };
      layers.push(newL);
      activeLayerId = newL.id;
      if(inp) inp.value = "";
      renderLayersUI();
      render();
      pushHistory();
    }
  });

  interactionCanvas.addEventListener("pointermove", e=>{
    const { x, y } = getCanvasCoords(e);

    if(activeTool === "pen" && isDraggingPenHandle && activeAnchorIndex !== null){
      const pt = activePenPath.points[activeAnchorIndex];
      if(pt){
        pt.handleOut = { x, y };
        pt.handleIn = { x: 2 * pt.x - x, y: 2 * pt.y - y };
        redrawPenOverlay();
      }
    } else if((activeTool === "brush" || activeTool === "eraser") && isDrawing && lastBrushPt){
      const pLayer = getOrCreateActivePaintLayer();
      if(!pLayer) return;
      const bSize = Number(document.getElementById("brushSize").value) || 28;
      const bOpacity = Number(document.getElementById("brushOpacity").value) || 100;
      const bFlow = Number(document.getElementById("brushFlow").value) || 80;
      const bColor = document.getElementById("brushColor").value || "#ff3545";
      const bType = (activeTool === "eraser") ? "eraser" : currentBrush;

      const dist = Math.hypot(x - lastBrushPt.x, y - lastBrushPt.y);
      const step = Math.max(2, bSize * 0.15);
      const steps = Math.ceil(dist / step);

      for(let i = 1; i <= steps; i++){
        const t = i / steps;
        const ix = lastBrushPt.x + (x - lastBrushPt.x) * t;
        const iy = lastBrushPt.y + (y - lastBrushPt.y) * t;
        drawBrushDab(pLayer.ctx, ix, iy, bType, bSize, bOpacity, bFlow, bColor);
      }
      lastBrushPt = { x, y };
      render();
    }

    // Interactive cursor outline indicator on interactionCanvas for brush
    if(activeTool === "brush" || activeTool === "eraser"){
      clearInteractionOverlay();
      const bSize = Number(document.getElementById("brushSize").value) || 28;
      interactionCtx.save();
      interactionCtx.beginPath();
      interactionCtx.arc(x, y, bSize / 2, 0, Math.PI * 2);
      interactionCtx.strokeStyle = (activeTool === "eraser") ? "rgba(255,80,100,0.8)" : "rgba(255,255,255,0.75)";
      interactionCtx.lineWidth = 1.5;
      interactionCtx.stroke();
      interactionCtx.restore();
    }
  });

  const stopDrawing = ()=>{
    if(isDrawing){
      isDrawing = false;
      lastBrushPt = null;
      pushHistory();
    }
    if(isDraggingPenHandle){
      isDraggingPenHandle = false;
      redrawPenOverlay();
    }
  };
  interactionCanvas.addEventListener("pointerup", stopDrawing);
  interactionCanvas.addEventListener("pointerleave", ()=>{
    stopDrawing();
    if(activeTool === "brush" || activeTool === "eraser") clearInteractionOverlay();
  });
}

/* ---------------------------------------------------------
   COMPOSITING & MULTI-LAYER RENDER PIPELINE
--------------------------------------------------------- */
render = function(){
  if(!canvas.width || !canvas.height) return;
  const w = canvas.width;
  const h = canvas.height;
  ctx.clearRect(0, 0, w, h);

  if(layers.length === 0 && originalImage){
    layers = [{
      id: "layer-img-" + Date.now(),
      name: "Base Artwork",
      type: "image",
      img: originalImage,
      visible: true,
      opacity: proState.opacity || 100,
      blendMode: "source-over",
      locked: false
    }];
    activeLayerId = layers[0].id;
    renderLayersUI();
  }

  // Iterate layers in bottom-to-top z-order
  for(let i = 0; i < layers.length; i++){
    const layer = layers[i];
    if(!layer.visible || layer.opacity <= 0) continue;

    ctx.save();
    ctx.globalAlpha = Math.max(0, Math.min(1, layer.opacity / 100));
    ctx.globalCompositeOperation = layer.blendMode || "source-over";

    switch(layer.type){
      case "background":
        if(layer.color !== "transparent"){
          ctx.fillStyle = layer.color || "#ffffff";
          ctx.fillRect(0, 0, w, h);
        }
        break;

      case "image": {
        const brightness = Number(document.getElementById("brightness")?.value || 0);
        const contrast = Number(document.getElementById("contrast")?.value || 0);
        const saturation = Number(document.getElementById("saturation")?.value || 0);
        const blur = Number(document.getElementById("blur")?.value || 0);
        const imgToDraw = layer.img || originalImage;

        if(imgToDraw){
          ctx.save();
          ctx.translate(w / 2 + w * (proState.x / 100), h / 2 + h * (proState.y / 100));
          ctx.rotate((proState.rotate * Math.PI) / 180);
          ctx.scale((proState.flipH ? -1 : 1) * (proState.scale / 100), (proState.flipV ? -1 : 1) * (proState.scale / 100));
          ctx.filter = `brightness(${100 + brightness}%) contrast(${100 + contrast}%) saturate(${100 + saturation}%) blur(${blur}px) hue-rotate(${proState.hue}deg) grayscale(${proState.grayscale}%) sepia(${proState.sepia}%)`;
          ctx.drawImage(imgToDraw, -w / 2, -h / 2, w, h);
          ctx.restore();
        }
        break;
      }

      case "paint":
        if(layer.canvas){
          ctx.drawImage(layer.canvas, 0, 0);
        }
        break;

      case "pen":
        drawPenLayer(layer);
        break;

      case "text":
        if(layer.data) drawTextLayer(layer.data);
        break;

      case "effect-watermark":
        if(layer.data) drawWatermarkLayer(layer.data);
        break;

      case "effect-clouds":
        if(layer.data) drawCloudsLayer(layer.data);
        break;

      case "effect-moon":
        if(layer.data) drawMoonLayer(layer.data);
        break;
    }

    ctx.restore();
  }

  // Global overlay elements
  if(document.getElementById("gradientType") && document.getElementById("gradientType").value !== "none" && colors.length > 0){
    ctx.save();
    ctx.globalCompositeOperation = document.getElementById("gradientBlend")?.value || "source-over";
    ctx.fillStyle = createGradient();
    ctx.fillRect(0, 0, w, h);
    ctx.restore();
  }

  drawPattern();
  drawTexture();
  drawVignette();

  // Legacy text layers compatibility
  textLayers.forEach(l => drawTextLayer(l));

  // Export-safe frame border
  if(proState.borderWidth > 0){
    ctx.save();
    ctx.lineWidth = proState.borderWidth * 2;
    ctx.strokeStyle = proState.borderColor;
    const inset = proState.borderWidth;
    const r = Math.min(proState.radius, Math.min(w, h) / 2);
    ctx.beginPath();
    if(r){
      ctx.roundRect(inset, inset, w - inset * 2, h - inset * 2, r);
    } else {
      ctx.rect(inset, inset, w - inset * 2, h - inset * 2);
    }
    ctx.stroke();
    ctx.restore();
  }

  ctx.globalAlpha = 1;
  ctx.globalCompositeOperation = "source-over";
  updateInfo();
  const hs = document.getElementById("hudSize");
  if(hs) hs.textContent = `${w} × ${h}`;
};

/* ---------------------------------------------------------
   ZOOM & HISTORY ENGINE
--------------------------------------------------------- */
function updateZoom(){
  document.getElementById("zoomReadout").textContent = Math.round(studioZoom * 100) + "%";
  const stage = document.getElementById("canvasStage") || canvas;
  stage.style.transform = `scale(${studioZoom})`;
  stage.style.transformOrigin = "center center";
}

document.getElementById("zoomIn")?.addEventListener("click", ()=>{ studioZoom = Math.min(3, studioZoom + 0.1); updateZoom(); });
document.getElementById("zoomOut")?.addEventListener("click", ()=>{ studioZoom = Math.max(0.15, studioZoom - 0.1); updateZoom(); });
document.getElementById("actualBtn")?.addEventListener("click", ()=>{ studioZoom = 1; updateZoom(); });
document.getElementById("fitBtn")?.addEventListener("click", ()=>{
  const wrap = document.querySelector(".canvas-wrap");
  if(wrap && canvas.width && canvas.height){
    const wrapW = wrap.clientWidth - 40;
    const wrapH = wrap.clientHeight - 40;
    studioZoom = Math.min(1, Math.min(wrapW / canvas.width, wrapH / canvas.height));
    updateZoom();
    wrap.scrollTo({ top: 0, left: 0 });
  } else {
    studioZoom = 1;
    updateZoom();
  }
});
document.getElementById("fullscreenBtn")?.addEventListener("click", ()=>{
  const el = document.querySelector(".canvas-panel");
  if(!document.fullscreenElement) el?.requestFullscreen?.();
  else document.exitFullscreen?.();
});

function snapshot(){
  return JSON.stringify({
    colors: [...colors],
    textLayers: JSON.parse(JSON.stringify(textLayers)),
    layers: layers.map(l => ({
      id: l.id,
      name: l.name,
      type: l.type,
      visible: l.visible,
      opacity: l.opacity,
      blendMode: l.blendMode,
      locked: l.locked,
      color: l.color,
      data: l.data ? JSON.parse(JSON.stringify(l.data)) : null,
      dataURL: l.canvas ? l.canvas.toDataURL() : null
    })),
    activeLayerId,
    selectedTextId,
    patternType,
    proState: JSON.parse(JSON.stringify(proState)),
    canvasDimensions: { width: canvas.width, height: canvas.height },
    values: {
      gradientType: document.getElementById("gradientType")?.value,
      angle: document.getElementById("angle")?.value,
      gradientOpacity: document.getElementById("gradientOpacity")?.value,
      gradientBlend: document.getElementById("gradientBlend")?.value,
      patternOpacity: document.getElementById("patternOpacity")?.value,
      patternSize: document.getElementById("patternSize")?.value,
      patternColor: document.getElementById("patternColor")?.value,
      textureType: document.getElementById("textureType")?.value,
      textureIntensity: document.getElementById("textureIntensity")?.value,
      brightness: document.getElementById("brightness")?.value,
      contrast: document.getElementById("contrast")?.value,
      saturation: document.getElementById("saturation")?.value,
      blur: document.getElementById("blur")?.value,
      vignette: document.getElementById("vignette")?.value
    }
  });
}

function restoreSnapshot(str){
  const s = JSON.parse(str);
  colors = s.colors;
  textLayers = s.textLayers;
  selectedTextId = s.selectedTextId;
  proState = s.proState;

  if(s.canvasDimensions && s.canvasDimensions.width){
    canvas.width = s.canvasDimensions.width;
    canvas.height = s.canvasDimensions.height;
    if(interactionCanvas){
      interactionCanvas.width = canvas.width;
      interactionCanvas.height = canvas.height;
    }
  }

  if(s.layers){
    layers = s.layers.map(sl => {
      const restored = { ...sl };
      if(sl.type === "image" && originalImage){
        restored.img = originalImage;
      }
      if(sl.type === "paint"){
        const pc = document.createElement("canvas");
        pc.width = canvas.width; pc.height = canvas.height;
        const pctx = pc.getContext("2d");
        if(sl.dataURL){
          const img = new Image();
          img.onload = () => { pctx.drawImage(img, 0, 0); render(); };
          img.src = sl.dataURL;
        }
        restored.canvas = pc;
        restored.ctx = pctx;
      }
      return restored;
    });
    activeLayerId = s.activeLayerId || (layers[0] ? layers[0].id : null);
  }

  Object.entries(s.values).forEach(([id, v])=>{
    const el = document.getElementById(id);
    if(el) el.value = v;
  });

  document.getElementById("patternControls").style.display = patternType === "none" ? "none" : "block";
  document.getElementById("textureControls").style.display = document.getElementById("textureType").value === "none" ? "none" : "block";

  renderColors();
  renderTextLayers();
  loadSelectedText();
  renderLayersUI();
  syncProUI();
  render();
  updateHistoryButtons();
}

function pushHistory(){
  if(historyLock) return;
  const now = snapshot();
  if(history[history.length - 1] !== now){
    history.push(now);
    if(history.length > 40) history.shift();
    future = [];
    updateHistoryButtons();
  }
}

function undo(){
  if(history.length < 2) return;
  historyLock = true;
  future.push(history.pop());
  restoreSnapshot(history[history.length - 1]);
  historyLock = false;
}

function redo(){
  if(!future.length) return;
  historyLock = true;
  const s = future.pop();
  history.push(s);
  restoreSnapshot(s);
  historyLock = false;
}

function updateHistoryButtons(){
  const u = document.getElementById("undoBtn"), r = document.getElementById("redoBtn");
  if(u && r){
    u.disabled = history.length < 2;
    r.disabled = !future.length;
    u.style.opacity = u.disabled ? .45 : 1;
    r.style.opacity = r.disabled ? .45 : 1;
  }
}

function syncProUI(){
  const map = {
    imageOpacity: ["imageOpacityValue", "%"],
    hueRotate: ["hueRotateValue", "°"],
    grayscale: ["grayscaleValue", "%"],
    sepia: ["sepiaValue", "%"],
    rotate: ["rotateValue", "°"],
    scale: ["scaleValue", "%"],
    imageX: ["imageXValue", ""],
    imageY: ["imageYValue", ""],
    cornerRadius: ["cornerRadiusValue", "px"],
    borderWidth: ["borderWidthValue", "px"]
  };
  Object.entries(map).forEach(([id, [v, suf]])=>{
    const e = document.getElementById(id), out = document.getElementById(v);
    if(e && out) out.textContent = e.value + suf;
  });
  const bc = document.getElementById("borderColor");
  if(bc) bc.value = proState.borderColor;
  const bh = document.getElementById("borderHex");
  if(bh) bh.value = proState.borderColor;
}

function bindRange(id, key, suffix){
  const e = document.getElementById(id);
  if(!e) return;
  e.addEventListener("input", ()=>{
    proState[key] = Number(e.value);
    const out = document.getElementById(id + "Value");
    if(out) out.textContent = e.value + suffix;
    if(liveRender) render();
  });
  e.addEventListener("change", pushHistory);
}

bindRange("imageOpacity", "opacity", "%");
bindRange("hueRotate", "hue", "°");
bindRange("grayscale", "grayscale", "%");
bindRange("sepia", "sepia", "%");
bindRange("rotate", "rotate", "°");
bindRange("scale", "scale", "%");
bindRange("imageX", "x", "");
bindRange("imageY", "y", "");
bindRange("cornerRadius", "radius", "px");
bindRange("borderWidth", "borderWidth", "px");

document.getElementById("flipH")?.addEventListener("click", ()=>{ pushHistory(); proState.flipH = !proState.flipH; render(); });
document.getElementById("flipV")?.addEventListener("click", ()=>{ pushHistory(); proState.flipV = !proState.flipV; render(); });
document.getElementById("borderColor")?.addEventListener("input", e=>{
  proState.borderColor = e.target.value;
  document.getElementById("borderHex").value = e.target.value;
  render();
});
document.getElementById("borderHex")?.addEventListener("change", e=>{
  let v = e.target.value.trim(); if(!v.startsWith("#")) v = "#" + v;
  if(/^#[0-9a-fA-F]{6}$/.test(v)){
    pushHistory();
    proState.borderColor = v;
    document.getElementById("borderColor").value = v;
    render();
  } else {
    e.target.value = proState.borderColor;
  }
});

document.getElementById("undoBtn")?.addEventListener("click", undo);
document.getElementById("redoBtn")?.addEventListener("click", redo);
document.getElementById("liveRenderBtn")?.addEventListener("click", e=>{
  liveRender = !liveRender;
  e.currentTarget.classList.toggle("active", liveRender);
  const hm = document.getElementById("hudMode");
  if(hm) hm.textContent = liveRender ? "Live render" : "Manual render";
});
document.getElementById("beforeAfterBtn")?.addEventListener("click", ()=>{
  compareMode = !compareMode;
  const btn = document.getElementById("beforeAfterBtn");
  btn.textContent = compareMode ? "After" : "Before";
  btn.classList.toggle("active", compareMode);
  if(compareMode && originalImage){
    canvas.width = originalImage.naturalWidth;
    canvas.height = originalImage.naturalHeight;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(originalImage, 0, 0, canvas.width, canvas.height);
  } else {
    render();
  }
});

window.addEventListener("keydown", e=>{
  if((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "z"){
    e.preventDefault();
    e.shiftKey ? redo() : undo();
  }
  if(e.code === "Space" && document.activeElement?.tagName !== "INPUT" && document.activeElement?.tagName !== "SELECT"){
    e.preventDefault();
    if(!e.repeat) document.getElementById("beforeAfterBtn")?.click();
  }
});

document.querySelectorAll("select,input[type=color],input[type=text],input[type=number],input[type=range]").forEach(el=>{
  el.addEventListener("change", ()=>setTimeout(pushHistory, 0));
});

setTimeout(()=>{
  history = [snapshot()];
  updateHistoryButtons();
  syncProUI();
  renderLayersUI();
  updateCursor();
}, 60);

</script>

</body>
</html>
