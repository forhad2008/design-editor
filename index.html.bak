function drawCloudsLayer(layerData){
  const w = canvas.width, h = canvas.height;
  const style = layerData.style || "cumulus";
  const density = (layerData.density || 65) / 100;
  const scale = layerData.scale || 60;
  const coverage = layerData.coverage || "full";
  const color = layerData.color || "#ffffff";
  const opacity = (layerData.opacity || 75) / 100;
  const seed = layerData.seed || 12345;

  ctx.save();
  ctx.globalAlpha = opacity;

  let startY = 0, endY = h;
  if(coverage === "top") endY = h * 0.58;
  else if(coverage === "bottom") startY = h * 0.45;

  const puffsCount = Math.round((w * (endY - startY) / (scale * scale)) * density * 0.55);
  function pseudoRand(s){
    const x = Math.sin(s++) * 10000;
    return { val: x - Math.floor(x), nextSeed: s };
  }
  let currentSeed = seed;

  for(let i = 0; i < puffsCount; i++){
    let r1, r2, r3;
    ({ val: r1, nextSeed: currentSeed } = pseudoRand(currentSeed));
    ({ val: r2, nextSeed: currentSeed } = pseudoRand(currentSeed));
    ({ val: r3, nextSeed: currentSeed } = pseudoRand(currentSeed));

    const cx = r1 * w;
    const cy = startY + r2 * (endY - startY);
    const radius = scale * (0.8 + r3 * 1.3);

    let puffAlpha = 0.16 * density;
    if(style === "mist") puffAlpha *= 0.65;
    else if(style === "storm") puffAlpha *= 1.4;

    const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius);
    if(style === "storm"){
      grad.addColorStop(0, "rgba(40,44,58," + puffAlpha + ")");
      grad.addColorStop(0.6, "rgba(25,28,38," + (puffAlpha * 0.6) + ")");
      grad.addColorStop(1, "transparent");
    } else if(style === "sunset"){
      grad.addColorStop(0, "rgba(255,180,90," + puffAlpha + ")");
      grad.addColorStop(0.5, "rgba(230,100,80," + (puffAlpha * 0.6) + ")");
      grad.addColorStop(1, "transparent");
    } else {
      grad.addColorStop(0, color);
      grad.addColorStop(0.5, color);
      grad.addColorStop(1, "transparent");
    }

    ctx.save();
    ctx.globalAlpha = opacity * puffAlpha;
    if(style === "mist"){
      ctx.translate(cx, cy);
      ctx.scale(2.4, 0.65);
      ctx.beginPath();
      ctx.arc(0, 0, radius, 0, Math.PI * 2);
    } else {
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    }
    ctx.fillStyle = grad;
    ctx.fill();
    ctx.restore();
  }

  ctx.restore();
}

