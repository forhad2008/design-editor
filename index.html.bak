  if(/^#[0-9a-fA-F]{6}$/.test(v)){ document.getElementById("penStrokeColor").value = v; redrawPenOverlay(); }
});
document.getElementById("penFillEnabled")?.addEventListener("change", e=>{
  document.getElementById("penFillColorRow").style.display = e.target.checked ? "flex" : "none";
  redrawPenOverlay();
});
