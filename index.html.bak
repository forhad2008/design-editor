  document.getElementById("layersTabContent").style.display = "none";
  document.getElementById("exportTabContent").style.display = "block";
});

/* ---------------------------------------------------------
   NEW DOCUMENT CREATOR & REAL SIZING PRESETS
--------------------------------------------------------- */
const DOC_PRESETS = {
  "a4-300": { w: 2480, h: 3508, unit: "mm", rw: 210, rh: 297, dpi: 300, name: "A4 Paper (300 DPI)" },
  "a4-150": { w: 1240, h: 1754, unit: "mm", rw: 210, rh: 297, dpi: 150, name: "A4 Paper (150 DPI)" },
  "a5-300": { w: 1748, h: 2480, unit: "mm", rw: 148, rh: 210, dpi: 300, name: "A5 Paper (300 DPI)" },
  "letter-300": { w: 2550, h: 3300, unit: "in", rw: 8.5, rh: 11, dpi: 300, name: "US Letter (300 DPI)" },
  "business-300": { w: 1050, h: 600, unit: "in", rw: 3.5, rh: 2, dpi: 300, name: "Business Card" },
  "poster-300": { w: 3600, h: 4800, unit: "in", rw: 12, rh: 16, dpi: 300, name: "Art Poster (300 DPI)" },
  "ig-square": { w: 1080, h: 1080, unit: "px", rw: 1080, rh: 1080, dpi: 72, name: "Instagram Square" },
  "ig-story": { w: 1080, h: 1920, unit: "px", rw: 1080, rh: 1920, dpi: 72, name: "Story / Reel / TikTok" },
  "yt-thumb": { w: 1280, h: 720, unit: "px", rw: 1280, rh: 720, dpi: 72, name: "YouTube Thumbnail" },
  "fhd": { w: 1920, h: 1080, unit: "px", rw: 1920, rh: 1080, dpi: 72, name: "Full HD 1080p" },
  "4k": { w: 3840, h: 2160, unit: "px", rw: 3840, rh: 2160, dpi: 72, name: "4K UHD" },
  "twitter-header": { w: 1500, h: 500, unit: "px", rw: 1500, rh: 500, dpi: 72, name: "Twitter/X Header" }
};

function calcDocPixels(){
  const wVal = parseFloat(document.getElementById("docWidth").value) || 1000;
  const hVal = parseFloat(document.getElementById("docHeight").value) || 1000;
  const unit = document.getElementById("docUnit").value;
  const dpi = parseFloat(document.getElementById("docDPI").value) || 300;
  let pxW = wVal, pxH = hVal;
  if(unit === "mm"){
    pxW = Math.round((wVal / 25.4) * dpi);
    pxH = Math.round((hVal / 25.4) * dpi);
  } else if(unit === "cm"){
    pxW = Math.round((wVal / 2.54) * dpi);
    pxH = Math.round((hVal / 2.54) * dpi);
  } else if(unit === "in"){
    pxW = Math.round(wVal * dpi);
    pxH = Math.round(hVal * dpi);
  }
  return { pxW: Math.max(30, pxW), pxH: Math.max(30, pxH), unit, dpi, wVal, hVal };
}

function updateDocSummary(){
  const c = calcDocPixels();
  const bg = selectedDocBg === "transparent" ? "Transparent" : (selectedDocBg === "#ffffff" ? "Pure White" : selectedDocBg);
  const badge = document.getElementById("docSummaryBadge");
  if(badge){
    badge.textContent = `Output: ${c.pxW} × ${c.pxH} pixels @ ${c.dpi} DPI · ${bg} Canvas`;
  }
}

function openNewDocModal(){
  document.getElementById("newDocModal").style.display = "flex";
  updateDocSummary();
}
function closeNewDocModal(){
  document.getElementById("newDocModal").style.display = "none";
}

["headerNewDocBtn", "toolbarNewDocBtn", "sideNewDocBtn", "emptyNewDocBtn"].forEach(id=>{
  document.getElementById(id)?.addEventListener("click", openNewDocModal);
});
["closeNewDocModal", "cancelNewDocBtn"].forEach(id=>{
  document.getElementById(id)?.addEventListener("click", closeNewDocModal);
});
document.getElementById("newDocModal")?.addEventListener("click", e=>{
  if(e.target.id === "newDocModal") closeNewDocModal();
});

document.querySelectorAll(".preset-card").forEach(card=>{
  card.addEventListener("click", ()=>{
    document.querySelectorAll(".preset-card").forEach(c=>c.classList.remove("active"));
    card.classList.add("active");
    const pKey = card.dataset.preset;
    const p = DOC_PRESETS[pKey];
    if(p){
      selectedPresetName = p.name;
      document.getElementById("docWidth").value = p.rw || p.w;
      document.getElementById("docHeight").value = p.rh || p.h;
      document.getElementById("docUnit").value = p.unit;
      document.getElementById("docDPI").value = p.dpi;
      updateDocSummary();
    }
  });
});

["docWidth", "docHeight", "docUnit", "docDPI"].forEach(id=>{
  document.getElementById(id)?.addEventListener("input", ()=>{
    document.querySelectorAll(".preset-card").forEach(c=>c.classList.remove("active"));
    selectedPresetName = "Custom Size";
    updateDocSummary();
  });
  document.getElementById(id)?.addEventListener("change", updateDocSummary);
});

document.getElementById("orientPortrait")?.addEventListener("click", ()=>{
  document.getElementById("orientPortrait").classList.add("active");
  document.getElementById("orientLandscape").classList.remove("active");
  const wEl = document.getElementById("docWidth"), hEl = document.getElementById("docHeight");
  const w = parseFloat(wEl.value), h = parseFloat(hEl.value);
  if(w > h){ wEl.value = h; hEl.value = w; updateDocSummary(); }
});
document.getElementById("orientLandscape")?.addEventListener("click", ()=>{
  document.getElementById("orientLandscape").classList.add("active");
  document.getElementById("orientPortrait").classList.remove("active");
  const wEl = document.getElementById("docWidth"), hEl = document.getElementById("docHeight");
  const w = parseFloat(wEl.value), h = parseFloat(hEl.value);
  if(w < h){ wEl.value = h; hEl.value = w; updateDocSummary(); }
});

document.querySelectorAll(".bg-choice").forEach(btn=>{
  btn.addEventListener("click", ()=>{
    document.querySelectorAll(".bg-choice").forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    selectedDocBg = btn.dataset.color;
    updateDocSummary();
  });
});
document.getElementById("docCustomBg")?.addEventListener("input", e=>{
  document.querySelectorAll(".bg-choice").forEach(b=>b.classList.remove("active"));
  selectedDocBg = e.target.value;
  updateDocSummary();
});

document.getElementById("confirmNewDocBtn")?.addEventListener("click", ()=>{
  const c = calcDocPixels();
  createDocument({
    width: c.pxW,
    height: c.pxH,
    bgColor: selectedDocBg,
    name: selectedPresetName
  });
});

function createDocument({ width, height, bgColor = "#ffffff", name = "New Canvas" }){
  canvas.width = width;
  canvas.height = height;
  if(interactionCanvas){
    interactionCanvas.width = width;
    interactionCanvas.height = height;
  }
  emptyState.style.display = "none";
  status.classList.add("ready");
  imageInfo.textContent = `${name} · ${width} × ${height} px`;
  sizeInfo.textContent = `${width} × ${height}`;

  // Base offscreen dummy image to maintain full compatibility with legacy adjust filters
  const off = document.createElement("canvas");
  off.width = width; off.height = height;
  const offC = off.getContext("2d");
  if(bgColor !== "transparent"){
    offC.fillStyle = bgColor;
    offC.fillRect(0, 0, width, height);
  }
  const dummy = new Image();
  dummy.src = off.toDataURL();
  originalImage = dummy;

  // Initialize Layer stack with Background layer
  layers = [{
    id: "layer-bg-" + Date.now(),
    name: "Background (" + (bgColor === "#ffffff" ? "White" : (bgColor === "transparent" ? "Transparent" : bgColor)) + ")",
    type: "background",
    color: bgColor,
    visible: true,
    opacity: 100,
    blendMode: "source-over",
    locked: true
  }];
  activeLayerId = layers[0].id;

  closeNewDocModal();

  setTimeout(()=>{
    const wrap = document.querySelector(".canvas-wrap");
    if(wrap){
      const wrapW = wrap.clientWidth - 40;
      const wrapH = wrap.clientHeight - 40;
      studioZoom = Math.min(1, Math.min(wrapW / width, wrapH / height));
      updateZoom();
    }
  }, 40);

  renderLayersUI();
  render();
  pushHistory();
}

/* ---------------------------------------------------------
   LAYERS SYSTEM & CUSTOMIZER
--------------------------------------------------------- */
function renderLayersUI(){
  const list = document.getElementById("layersList");
  if(!list) return;
  list.innerHTML = "";

  document.getElementById("layerCountBadge").textContent = layers.length;

  let activeLayer = layers.find(l => l.id === activeLayerId);
  if(!activeLayer && layers.length > 0){
    activeLayer = layers[layers.length - 1];
    activeLayerId = activeLayer.id;
  }

  if(activeLayer){
    document.getElementById("activeLayerTitle").textContent = "ACTIVE: " + (activeLayer.name || "Layer");
    document.getElementById("layerOpacity").value = activeLayer.opacity;
    document.getElementById("layerOpacityValue").textContent = activeLayer.opacity + "%";
    document.getElementById("layerBlendMode").value = activeLayer.blendMode || "source-over";
    document.getElementById("lockLayerBtn").textContent = activeLayer.locked ? "🔒" : "🔓";
    document.getElementById("lockLayerBtn").title = activeLayer.locked ? "Layer Locked (click to unlock)" : "Layer Unlocked (click to lock)";
  }

  // Render from top of stack to bottom
  for(let i = layers.length - 1; i >= 0; i--){
    const layer = layers[i];
    const row = document.createElement("div");
    row.className = "layer-row" + (layer.id === activeLayerId ? " active" : "") + (!layer.visible ? " hidden-layer" : "");

    // Eye button
    const eyeBtn = document.createElement("button");
    eyeBtn.className = "layer-eye-btn";
    eyeBtn.innerHTML = layer.visible ? "👁" : "🚫";
    eyeBtn.title = layer.visible ? "Hide layer" : "Show layer";
    eyeBtn.addEventListener("click", e=>{
      e.stopPropagation();
      layer.visible = !layer.visible;
      renderLayersUI();
      render();
      pushHistory();
    });

    // Icon
    const icon = document.createElement("div");
    icon.className = "layer-type-icon";
    icon.textContent = getLayerTypeIcon(layer.type);

    // Name
    const nameWrap = document.createElement("div");
    nameWrap.className = "layer-name-wrap";
    const nameText = document.createElement("div");
    nameText.className = "layer-name-text";
    nameText.textContent = layer.name;
    nameWrap.appendChild(nameText);

    // Double click to rename
    nameWrap.addEventListener("dblclick", e=>{
      e.stopPropagation();
      const newName = prompt("Rename layer:", layer.name);
      if(newName && newName.trim()){
        layer.name = newName.trim();
        renderLayersUI();
        pushHistory();
      }
    });

    // Opacity badge
    const badge = document.createElement("div");
    badge.className = "layer-badge";
    badge.textContent = layer.opacity + "%";

    // Delete button
    const delBtn = document.createElement("button");
    delBtn.className = "layer-del-btn";
    delBtn.innerHTML = "✕";
    delBtn.title = "Delete layer";
    delBtn.addEventListener("click", e=>{
      e.stopPropagation();
      deleteLayer(layer.id);
    });

    row.appendChild(eyeBtn);
    row.appendChild(icon);
    row.appendChild(nameWrap);
    row.appendChild(badge);
    row.appendChild(delBtn);

    row.addEventListener("click", ()=>{
      activeLayerId = layer.id;
      renderLayersUI();
    });

    list.appendChild(row);
  }
}

function getLayerTypeIcon(type){
  switch(type){
    case "background": return "🖼";
    case "image": return "📷";
    case "paint": return "🎨";
    case "pen": return "✒️";
    case "text": return "🔤";
    case "effect-watermark": return "💧";
    case "effect-clouds": return "☁️";
    case "effect-moon": return "🌕";
    default: return "📄";
  }
}

function deleteLayer(id){
  if(layers.length <= 1){
    alert("Cannot delete the only layer.");
    return;
  }
  const idx = layers.findIndex(l => l.id === id);
  if(idx === -1) return;
  layers.splice(idx, 1);
  if(activeLayerId === id){
    activeLayerId = layers[Math.max(0, idx - 1)].id;
  }
  renderLayersUI();
  render();
  pushHistory();
}

document.getElementById("layerOpacity")?.addEventListener("input", e=>{
  const val = Number(e.target.value);
  document.getElementById("layerOpacityValue").textContent = val + "%";
  const activeLayer = layers.find(l => l.id === activeLayerId);
  if(activeLayer){
    activeLayer.opacity = val;
    renderLayersUI();
    if(liveRender) render();
  }
});
document.getElementById("layerOpacity")?.addEventListener("change", pushHistory);

document.getElementById("layerBlendMode")?.addEventListener("change", e=>{
  const activeLayer = layers.find(l => l.id === activeLayerId);
  if(activeLayer){
    activeLayer.blendMode = e.target.value;
    render();
    pushHistory();
  }
});

document.getElementById("lockLayerBtn")?.addEventListener("click", ()=>{
  const activeLayer = layers.find(l => l.id === activeLayerId);
  if(activeLayer){
    activeLayer.locked = !activeLayer.locked;
    renderLayersUI();
    pushHistory();
  }
});

function addPaintLayer(){
  const w = canvas.width || 1200, h = canvas.height || 800;
  const off = document.createElement("canvas");
  off.width = w; off.height = h;
  const offCtx = off.getContext("2d");
  const pCount = layers.filter(l => l.type === "paint").length + 1;
  const newL = {
    id: "layer-paint-" + Date.now(),
    name: "Paint Layer " + pCount,
    type: "paint",
    canvas: off,
    ctx: offCtx,
    visible: true,
    opacity: 100,
    blendMode: "source-over",
    locked: false
  };
  layers.push(newL);
  activeLayerId = newL.id;
  renderLayersUI();
  pushHistory();
}
document.getElementById("addPaintLayerBtn")?.addEventListener("click", addPaintLayer);

document.getElementById("addTextLayerBtn")?.addEventListener("click", ()=>{
  const tCount = layers.filter(l => l.type === "text").length + 1;
  const newL = {
    id: "layer-text-" + Date.now(),
    name: "Text " + tCount,
    type: "text",
    visible: true,
    opacity: 100,
    blendMode: "source-over",
    locked: false,
    data: {
      text: "Creative Typography",
      font: "Playfair Display",
      size: 96,
      weight: "700",
      x: 50,
      y: 50,
      color: "#ffffff",
      opacity: 1,
      letterSpacing: 0,
      shadow: 8,
      stroke: 0,
      strokeColor: "#000000",
      arc: 0
    }
  };
  layers.push(newL);
  activeLayerId = newL.id;
  renderLayersUI();
  render();
  pushHistory();
});

document.getElementById("duplicateLayerBtn")?.addEventListener("click", ()=>{
  const activeLayer = layers.find(l => l.id === activeLayerId);
  if(!activeLayer) return;
  const clone = JSON.parse(JSON.stringify(activeLayer, (k, v)=>{
    if(k === "canvas" || k === "ctx" || k === "img") return undefined;
    return v;
  }));
  clone.id = "layer-copy-" + Date.now();
  clone.name = "Copy of " + activeLayer.name;

  if(activeLayer.type === "paint" && activeLayer.canvas){
    const off = document.createElement("canvas");
    off.width = activeLayer.canvas.width; off.height = activeLayer.canvas.height;
    const offCtx = off.getContext("2d");
    offCtx.drawImage(activeLayer.canvas, 0, 0);
    clone.canvas = off;
    clone.ctx = offCtx;
  }
  if(activeLayer.type === "image" && activeLayer.img){
    clone.img = activeLayer.img;
  }

  const idx = layers.findIndex(l => l.id === activeLayerId);
  layers.splice(idx + 1, 0, clone);
  activeLayerId = clone.id;
  renderLayersUI();
  render();
  pushHistory();
});

document.getElementById("moveLayerUpBtn")?.addEventListener("click", ()=>{
  const idx = layers.findIndex(l => l.id === activeLayerId);
  if(idx === -1 || idx >= layers.length - 1) return;
  const item = layers.splice(idx, 1)[0];
  layers.splice(idx + 1, 0, item);
  renderLayersUI();
  render();
  pushHistory();
});

document.getElementById("moveLayerDownBtn")?.addEventListener("click", ()=>{
  const idx = layers.findIndex(l => l.id === activeLayerId);
  if(idx <= 0) return;
  const item = layers.splice(idx, 1)[0];
  layers.splice(idx - 1, 0, item);
  renderLayersUI();
  render();
  pushHistory();
});

document.getElementById("deleteLayerBtn")?.addEventListener("click", ()=>{
  if(activeLayerId) deleteLayer(activeLayerId);
});

