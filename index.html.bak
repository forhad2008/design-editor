function drawWatermarkLayer(layerData){
  const w = canvas.width, h = canvas.height;
  const text = layerData.text || "© ARTFORGE STUDIO";
  const layout = layerData.layout || "tiled";
  const opacity = (layerData.opacity || 28) / 100;
  const fontSize = layerData.fontSize || 26;
  const angle = (layerData.angle || -30) * Math.PI / 180;
  const color = layerData.color || "#ffffff";

  ctx.save();
  ctx.globalAlpha = opacity;
  ctx.font = `600 ${fontSize}px Inter, Arial, sans-serif`;
  ctx.fillStyle = color;

  if(layout === "tiled"){
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    const stepX = Math.max(130, fontSize * 8.5);
    const stepY = Math.max(80, fontSize * 5);
    for(let py = -h; py < h * 2; py += stepY){
      for(let px = -w; px < w * 2; px += stepX){
        ctx.save();
        ctx.translate(px, py);
        ctx.rotate(angle);
        ctx.shadowColor = "rgba(0,0,0,0.5)";
        ctx.shadowBlur = 4;
        ctx.fillText(text, 0, 0);
        ctx.restore();
      }
    }
  } else {
    ctx.shadowColor = "rgba(0,0,0,0.6)";
    ctx.shadowBlur = 6;
    let tx = w / 2, ty = h / 2;
    if(layout === "bottom-right"){
      ctx.textAlign = "right"; ctx.textBaseline = "bottom";
      tx = w - 40; ty = h - 35;
    } else if(layout === "bottom-center"){
      ctx.textAlign = "center"; ctx.textBaseline = "bottom";
      tx = w / 2; ty = h - 35;
    } else {
      ctx.textAlign = "center"; ctx.textBaseline = "middle";
    }
    ctx.save();
    ctx.translate(tx, ty);
    ctx.rotate(angle);
    ctx.fillText(text, 0, 0);
    ctx.restore();
  }
  ctx.restore();
}

