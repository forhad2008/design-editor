                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="textStroke"
                            min="0"
                            max="20"
                            value="0">

                        <span
                            class="range-value"
                            id="textStrokeValue">
                            0
                        </span>

                    </div>

                </div>

                <div class="control">

                    <label class="label">
                        Stroke Color
                    </label>

                    <div class="text-color-row">

                        <input
                            type="color"
                            class="text-color"
                            id="textStrokeColor"
                            value="#000000">

                        <input
                            type="text"
                            id="textStrokeHex"
                            value="#000000">

                    </div>

                </div>


                <button
