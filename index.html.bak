/* =========================================================
   CREATIVE STUDIO & ADVANCED TOOLS ENGINE
   - Document Creator with Real Sizing (A4, A5, Letter, IG, FHD, Custom cm/in/DPI)
   - Photoshop CS6 Pen Tool (Bézier curves, anchors, handles, close, vector layers)
   - Artistic Brush Studio (Soft round, hard round, airbrush, calligraphy, sparkle, cloud, neon glow, eraser)
   - Layers System & Customizer (Visibility eye, opacity slider, blend modes, delete, duplicate, reorder)
   - Creative Effects (Watermark system, procedural clouds, celestial moon)
========================================================= */

const interactionCanvas = document.getElementById("interactionCanvas");
const interactionCtx = interactionCanvas ? interactionCanvas.getContext("2d") : null;
const canvasStage = document.getElementById("canvasStage");

let layers = [];
let activeLayerId = null;
let activeTool = "select"; // "select", "pen", "brush", "text", "eraser"

let selectedDocBg = "#ffffff";
let selectedPresetName = "A4 Paper (300 DPI)";

let penMode = "draw";
let activePenPath = { points: [], isClosed: false };
let isDraggingPenHandle = false;
let activeAnchorIndex = null;

let currentBrush = "soft-round";
let isDrawing = false;
let lastBrushPt = null;
let activeCloudSeed = 12345;

let proState = {
  opacity:100, hue:0, grayscale:0, sepia:0, rotate:0, scale:100, x:0, y:0,
  flipH:false, flipV:false, radius:0, borderWidth:0, borderColor:"#ffffff"
};
let studioZoom=1, compareMode=false, liveRender=true;
let history=[], future=[], historyLock=false;

/* ---------------------------------------------------------
   TOOL SWITCHER & SHORTCUTS
--------------------------------------------------------- */
function updateCursor(){
  const target = interactionCanvas || canvas;
  if(!target) return;
  target.classList.remove("cursor-pen", "cursor-brush", "cursor-text", "cursor-eraser");
  if(activeTool === "pen") target.classList.add("cursor-pen");
  else if(activeTool === "brush") target.classList.add("cursor-brush");
  else if(activeTool === "eraser") target.classList.add("cursor-eraser");
  else if(activeTool === "text") target.classList.add("cursor-text");
}

document.querySelectorAll("#mainToolSwitch .tool-btn").forEach(btn=>{
  btn.addEventListener("click", ()=>{
    document.querySelectorAll("#mainToolSwitch .tool-btn").forEach(b=>b.classList.remove("active"));
    btn.classList.add("active");
    activeTool = btn.dataset.tool;
    updateCursor();

    if(activeTool === "pen"){
      document.getElementById("penToolSection")?.scrollIntoView({ behavior:"smooth", block:"nearest" });
      redrawPenOverlay();
    } else if(activeTool === "brush" || activeTool === "eraser"){
      document.getElementById("brushToolSection")?.scrollIntoView({ behavior:"smooth", block:"nearest" });
      clearInteractionOverlay();
    } else if(activeTool === "text"){
      document.getElementById("textInput")?.focus();
      clearInteractionOverlay();
    } else {
      clearInteractionOverlay();
    }
  });
});

window.addEventListener("keydown", e=>{
  if(document.activeElement?.tagName === "INPUT" || document.activeElement?.tagName === "SELECT" || document.activeElement?.tagName === "TEXTAREA") return;
  const k = e.key.toLowerCase();
  if(k === "v") document.querySelector('#mainToolSwitch [data-tool="select"]')?.click();
  else if(k === "p") document.querySelector('#mainToolSwitch [data-tool="pen"]')?.click();
  else if(k === "b") document.querySelector('#mainToolSwitch [data-tool="brush"]')?.click();
  else if(k === "t") document.querySelector('#mainToolSwitch [data-tool="text"]')?.click();
  else if(k === "e") document.querySelector('#mainToolSwitch [data-tool="eraser"]')?.click();
});

