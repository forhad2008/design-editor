   APPLY / RENDER
========================================================= */

document
.getElementById("applyBtn")
.addEventListener("click",()=>{

    if(!originalImage){

        alert(
            "Please upload an image first."
        );

        return;
    }

    render();

});


/* =========================================================
   EXPORT
========================================================= */

document
.getElementById("downloadBtn")
.addEventListener("click",()=>{

    if(!originalImage){

        alert(
            "Please upload an image first."
        );

        return;
    }

    render();


    let mime;

    let extension;


    if(exportFormat === "jpeg"){

        mime =
            "image/jpeg";

        extension =
            "jpg";

    }

    else if(exportFormat === "webp"){

        mime =
            "image/webp";

        extension =
            "webp";

    }

    else{

        mime =
            "image/png";

        extension =
            "png";

    }


    const quality =
        Number(
            document.getElementById("quality").value
        ) / 100;


    canvas.toBlob(
        blob=>{

            if(!blob){

                alert(
                    "Unable to export artwork."
                );

                return;
            }


            const url =
                URL.createObjectURL(blob);

            const a =
                document.createElement("a");


            let filename =
                document.getElementById("fileName")
                    .value
                    .trim();


            if(!filename){

                filename =
                    "my-artwork";

            }


            filename =
                filename
                .replace(/[<>:"/\\|?*]+/g,"-");


            a.href =
                url;

            a.download =
                `${filename}.${extension}`;


            document.body.appendChild(a);

            a.click();

            a.remove();

            URL.revokeObjectURL(url);


        },
        mime,
        quality
    );

});


/* =========================================================
   INFORMATION
========================================================= */

function updateInfo(){

    if(!originalImage){
        return;
    }

    const width =
        canvas.width;

    const height =
        canvas.height;


    sizeInfo.textContent =
        `${width} × ${height}`;


    document.getElementById("exportInfo")
        .innerHTML = `
            <strong style="color:#aaa;">
                ${width} × ${height}px
            </strong><br>
            ${textLayers.length} text layer${textLayers.length===1?"":"s"}<br>
            Gradient: ${document.getElementById("gradientType").value}<br>
            Pattern: ${patternType}<br>
            Texture: ${document.getElementById("textureType").value}<br>
            Export: ${exportFormat.toUpperCase()}
        `;

}


