                    Delete Selected Text
                </button>

            </div>

        </div>


        <!-- PATTERN -->

        <div class="section">

            <div class="section-heading">
                05 — Pattern
            </div>

            <div class="pattern-grid">

                <button
                    class="pattern-option active"
                    data-pattern="none"
                    style="background:#202020">
                </button>

                <button
                    class="pattern-option"
                    data-pattern="dots"
                    style="background-image:radial-gradient(#aaa 1px,transparent 1px);background-size:10px 10px">
                </button>

                <button
                    class="pattern-option"
                    data-pattern="grid"
                    style="background-image:linear-gradient(#777 1px,transparent 1px),linear-gradient(90deg,#777 1px,transparent 1px);background-size:12px 12px">
                </button>

                <button
                    class="pattern-option"
                    data-pattern="diagonal"
                    style="background-image:repeating-linear-gradient(45deg,#777 0 1px,transparent 1px 8px)">
                </button>

                <button
                    class="pattern-option"
                    data-pattern="cross"
                    style="background-image:linear-gradient(#777 1px,transparent 1px),linear-gradient(90deg,#777 1px,transparent 1px);background-size:18px 18px">
                </button>

                <button
                    class="pattern-option"
                    data-pattern="diamond"
                    style="background-image:linear-gradient(45deg,transparent 48%,#777 49%,#777 51%,transparent 52%),linear-gradient(-45deg,transparent 48%,#777 49%,#777 51%,transparent 52%);background-size:18px 18px">
                </button>

            </div>


            <div
                id="patternControls"
                style="display:none;margin-top:13px;">

                <div class="control">

                    <label class="label">
                        Pattern Opacity
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="patternOpacity"
                            min="0"
                            max="100"
                            value="25">

                        <span
                            class="range-value"
                            id="patternOpacityValue">
                            25%
                        </span>

                    </div>

                </div>


                <div class="control">

                    <label class="label">
                        Pattern Size
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="patternSize"
                            min="5"
                            max="100"
                            value="24">

                        <span
                            class="range-value"
                            id="patternSizeValue">
                            24
                        </span>

                    </div>

                </div>


                <div class="control">

                    <label class="label">
                        Pattern Color
                    </label>

                    <input
                        type="color"
                        id="patternColor"
                        value="#ffffff"
                        class="text-color">

                </div>

            </div>

        </div>


        <!-- TEXTURE -->

        <div class="section">

            <div class="section-heading">
                06 — Texture
            </div>

            <select id="textureType">

                <option value="none">
                    No Texture
                </option>

                <option value="grain">
                    Film Grain
                </option>

                <option value="noise">
                    Noise
                </option>

                <option value="paper">
                    Paper
                </option>

                <option value="dust">
                    Dust
                </option>

                <option value="scanlines">
                    Scanlines
                </option>

                <option value="soft">
                    Soft Grain
                </option>

            </select>


            <div
                id="textureControls"
                style="display:none;margin-top:13px;">

                <div class="control">

                    <label class="label">
                        Texture Intensity
                    </label>

                    <div class="range-row">

                        <input
                            type="range"
                            id="textureIntensity"
                            min="0"
                            max="100"
                            value="20">

                        <span
                            class="range-value"
                            id="textureIntensityValue">
                            20%
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- IMAGE ADJUSTMENTS -->

        <div class="section">

            <div class="section-heading">
                07 — Image Adjustments
            </div>


            <div class="control">

                <label class="label">
                    Brightness
                </label>

                <div class="range-row">

                    <input
                        type="range"
                        id="brightness"
                        min="-100"
                        max="100"
                        value="0">

                    <span
                        class="range-value"
                        id="brightnessValue">
                        0
                    </span>

                </div>

            </div>


            <div class="control">

                <label class="label">
                    Contrast
                </label>

                <div class="range-row">

                    <input
                        type="range"
                        id="contrast"
                        min="-100"
                        max="100"
                        value="0">

                    <span
                        class="range-value"
                        id="contrastValue">
                        0
                    </span>

                </div>

            </div>


            <div class="control">

                <label class="label">
                    Saturation
                </label>

                <div class="range-row">

                    <input
                        type="range"
                        id="saturation"
                        min="-100"
                        max="100"
                        value="0">

                    <span
                        class="range-value"
                        id="saturationValue">
                        0
                    </span>

                </div>

            </div>


            <div class="control">

                <label class="label">
                    Blur
                </label>

                <div class="range-row">

                    <input
                        type="range"
                        id="blur"
                        min="0"
                        max="20"
                        value="0">

                    <span
                        class="range-value"
                        id="blurValue">
                        0
                    </span>

                </div>

            </div>


            <div class="control">

                <label class="label">
                    Vignette
                </label>

                <div class="range-row">

                    <input
                        type="range"
                        id="vignette"
                        min="0"
                        max="100"
                        value="0">

                    <span
                        class="range-value"
                        id="vignetteValue">
                        0%
                    </span>

                </div>

            </div>

        </div>


        <div class="two">

            <button
                class="button"
                id="resetBtn">
                Reset
            </button>

            <button
                class="button primary"
                id="applyBtn">
                Render
            </button>

        </div>

    </div>

</aside>


<!-- ======================================================
     CENTER CANVAS
====================================================== -->

<section class="workspace">

    <div class="canvas-panel">

        <div class="canvas-toolbar">

            <div
                class="image-info"
                id="imageInfo">
                No image selected
            </div>

            <div class="format-buttons">

                <button
                    class="format active"
                    data-format="png">
                    PNG
                </button>

                <button
                    class="format"
                    data-format="jpeg">
                    JPG
                </button>

                <button
                    class="format"
                    data-format="webp">
                    WebP
                </button>

            </div>

        </div>


        <div class="canvas-wrap">

            <div class="canvas-stage" id="canvasStage" style="position:relative;display:inline-block;line-height:0;">
                <canvas id="canvas"></canvas>
                <canvas id="interactionCanvas" style="position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:auto;cursor:crosshair;"></canvas>
            </div>

            <div
                class="empty"
                id="emptyState"
                style="pointer-events:auto;text-align:center;">

                <!-- BIG UPLOAD ARTWORK BOX (Click or Drop image to upload) -->
                <div class="upload" id="canvasUploadBox" style="display:inline-block;max-width:480px;width:92%;cursor:pointer;padding:36px 28px;border:2px dashed var(--border2);border-radius:20px;background:rgba(16,16,16,.88);backdrop-filter:blur(16px);transition:.25s;box-shadow:0 12px 35px rgba(0,0,0,0.5);">

                    <div class="upload-icon" style="margin:0 auto 14px;width:60px;height:60px;font-size:28px;border-radius:18px;display:flex;align-items:center;justify-content:center;">
                        ＋
                    </div>

                    <strong style="font-size:18px;letter-spacing:-.4px;display:block;margin-bottom:6px;color:#fff;">
                        Upload Artwork
                    </strong>

                    <p style="margin-bottom:16px;color:#888;font-size:12px;line-height:1.5;">
                        Drag and drop your image here, or click to browse<br>
                        <small style="color:#666;font-size:11px;">JPG · PNG · WebP</small>
                    </p>

                    <button class="button primary" id="canvasChooseFileBtn" type="button" style="padding:10px 22px;font-weight:700;display:inline-flex;align-items:center;gap:6px;cursor:pointer;">
                        📁 Choose File
                    </button>

                </div>

                <!-- SEPARATE CREATE NEW PAGE ACTION (Isolated from Upload Artwork) -->
                <div style="margin-top:14px;">
                    <button class="button" id="emptyNewDocBtn" type="button" style="padding:9px 18px;font-size:11.5px;font-weight:600;display:inline-flex;align-items:center;gap:6px;background:rgba(22,22,22,0.85);border:1px solid var(--border);cursor:pointer;">
                        ✦ Or Create New White Page (Real Sizing)
                    </button>
                </div>

            </div>

        </div>


        <div
            class="status"
            id="status">

            <div>
                <span class="dot"></span>
                Waiting for artwork
            </div>

            <div id="sizeInfo">
                —
            </div>

        </div>

    </div>

</section>


<!-- ======================================================
     RIGHT PANEL
====================================================== -->

<aside class="panel right-panel">

    <div class="panel-tab-header">
        <button class="panel-tab active" id="tabLayersBtn" type="button">
            📑 Layers (<span id="layerCountBadge">1</span>)
        </button>
        <button class="panel-tab" id="tabExportBtn" type="button">
            ⬇ Export
        </button>
    </div>

    <!-- LAYERS TAB CONTENT -->
    <div id="layersTabContent" class="panel-inner" style="display:block;">

        <!-- Active Layer Properties Customizer -->
        <div class="layers-customizer">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                <div style="font-size:10px;font-weight:800;color:var(--accent2);letter-spacing:1px;" id="activeLayerTitle">
                    ACTIVE LAYER
                </div>
                <button id="lockLayerBtn" title="Lock / Unlock Layer" type="button" style="background:none;border:none;color:#889;cursor:pointer;font-size:13px;">
                    🔓
                </button>
            </div>

            <!-- Layer Opacity ("visibility low this king of system") -->
            <div class="control" style="margin-bottom:8px;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                    <label class="label" style="margin-bottom:0;">Layer Opacity / Visibility</label>
                    <span class="range-value" id="layerOpacityValue" style="color:var(--accent2);font-weight:800;">100%</span>
                </div>
                <input type="range" id="layerOpacity" min="0" max="100" value="100">
            </div>

            <!-- Layer Blend Mode -->
            <div class="control" style="margin-bottom:0;">
                <label class="label">Blend Mode</label>
                <select id="layerBlendMode">
                    <option value="source-over">Normal</option>
                    <option value="multiply">Multiply</option>
                    <option value="screen">Screen</option>
                    <option value="overlay">Overlay</option>
                    <option value="soft-light">Soft Light</option>
                    <option value="hard-light">Hard Light</option>
                    <option value="color-dodge">Color Dodge</option>
                    <option value="darken">Darken</option>
                    <option value="lighten">Lighten</option>
                    <option value="difference">Difference</option>
                </select>
            </div>
        </div>

        <!-- Layers Stack List -->
        <div class="section-heading" style="display:flex;justify-content:space-between;align-items:center;">
            <span>Layer Stack (Top to Bottom)</span>
            <span style="font-size:9px;color:#7c5cff;">Click to select</span>
        </div>

        <div class="layers-list" id="layersList">
            <!-- Populated dynamically by renderLayersUI() -->
        </div>

        <!-- Layer Action Buttons -->
        <div class="layers-toolbar">
            <button class="layer-btn-mini" id="addPaintLayerBtn" title="Add New Drawing / Paint Layer" type="button">
                +🎨 Paint
            </button>
            <button class="layer-btn-mini" id="addTextLayerBtn" title="Add New Text Layer" type="button">
                +🔤 Text
            </button>
            <button class="layer-btn-mini" id="duplicateLayerBtn" title="Duplicate Active Layer" type="button">
                ⎘ Duplicate
            </button>
            <button class="layer-btn-mini" id="moveLayerUpBtn" title="Move Layer Up" type="button">
                ▲ Up
            </button>
            <button class="layer-btn-mini" id="moveLayerDownBtn" title="Move Layer Down" type="button">
                ▼ Down
            </button>
            <button class="layer-btn-mini" id="deleteLayerBtn" title="Delete Active Layer" type="button" style="color:var(--danger);">
                🗑 Delete
            </button>
        </div>

    </div>

    <!-- EXPORT TAB CONTENT -->
    <div id="exportTabContent" class="panel-inner" style="display:none;">
        <div class="section">
            <div class="section-heading">
                Export Settings
            </div>

            <div class="control">
                <label class="label">Artwork Name</label>
                <div class="export-name">
                    <input type="text" id="fileName" value="my-artwork">
                    <div class="extension" id="extension">PNG</div>
                </div>
            </div>

            <div class="control">
                <label class="label">Export Quality</label>
                <div class="range-row">
                    <input type="range" id="quality" min="50" max="100" value="95">
                    <span class="range-value" id="qualityValue">95%</span>
                </div>
            </div>
        </div>

        <div class="section">
            <button class="button light full" id="downloadBtn">
                ↓ Download Artwork
            </button>
        </div>

        <div class="section">
            <div class="section-heading">
                Artwork Information
            </div>
            <div id="exportInfo" style="color:#777;font-size:11px;line-height:1.8;">
                Upload an image or create a new page to see artwork information.
            </div>
        </div>

        <div class="section">
            <div class="section-heading">
                Studio Tools Guide
            </div>
            <div style="color:#666;font-size:10px;line-height:1.8;">
                • <b>V (Select)</b>: Move and transform layers<br>
                • <b>P (Pen)</b>: Photoshop CS6 Bézier vector paths<br>
                • <b>B (Brush)</b>: Artistic presets & freehand painting<br>
                • <b>T (Text)</b>: Rich typography & curved arc text<br>
                • <b>E (Eraser)</b>: Erase paint layer strokes<br>
                • <b>Layers</b>: Reorder, toggle eye, opacity, blend modes
            </div>
        </div>
    </div>

</aside>

</div>

</main>


<!-- ======================================================
     NEW DOCUMENT / CANVAS MODAL
====================================================== -->
<div class="modal-backdrop" id="newDocModal" style="display:none;">
  <div class="modal-dialog">
    <div class="modal-header">
      <div class="modal-title">
        <span style="color:var(--accent2);font-size:18px;">✦</span> New Canvas / Document Creator
      </div>
      <button class="modal-close" id="closeNewDocModal" type="button">&times;</button>
    </div>

    <div class="modal-body">
      <!-- Presets Category: Print (Real Sizing) -->
      <div class="modal-section-title">REAL SIZING PRESETS (PRINT)</div>
      <div class="preset-grid modal-preset-grid">
        <button class="preset-card active" data-preset="a4-300" data-w="2480" data-h="3508" data-unit="mm" data-rw="210" data-rh="297" data-dpi="300" type="button">
          <div class="preset-name">A4 Paper (300 DPI)</div>
          <div class="preset-dim">210 × 297 mm · 2480 × 3508 px</div>
        </button>
        <button class="preset-card" data-preset="a4-150" data-w="1240" data-h="1754" data-unit="mm" data-rw="210" data-rh="297" data-dpi="150" type="button">
          <div class="preset-name">A4 Paper (150 DPI)</div>
          <div class="preset-dim">210 × 297 mm · 1240 × 1754 px</div>
        </button>
        <button class="preset-card" data-preset="a5-300" data-w="1748" data-h="2480" data-unit="mm" data-rw="148" data-rh="210" data-dpi="300" type="button">
          <div class="preset-name">A5 Paper (300 DPI)</div>
          <div class="preset-dim">148 × 210 mm · 1748 × 2480 px</div>
        </button>
        <button class="preset-card" data-preset="letter-300" data-w="2550" data-h="3300" data-unit="in" data-rw="8.5" data-rh="11" data-dpi="300" type="button">
          <div class="preset-name">US Letter (300 DPI)</div>
          <div class="preset-dim">8.5 × 11 in · 2550 × 3300 px</div>
        </button>
        <button class="preset-card" data-preset="business-300" data-w="1050" data-h="600" data-unit="in" data-rw="3.5" data-rh="2" data-dpi="300" type="button">
          <div class="preset-name">Business Card</div>
          <div class="preset-dim">3.5 × 2 in · 1050 × 600 px</div>
        </button>
        <button class="preset-card" data-preset="poster-300" data-w="3600" data-h="4800" data-unit="in" data-rw="12" data-rh="16" data-dpi="300" type="button">
          <div class="preset-name">Art Poster (300 DPI)</div>
          <div class="preset-dim">12 × 16 in · 3600 × 4800 px</div>
        </button>
      </div>

      <!-- Presets Category: Digital / Social -->
      <div class="modal-section-title" style="margin-top:14px;">DIGITAL & SOCIAL MEDIA PRESETS</div>
      <div class="preset-grid modal-preset-grid">
        <button class="preset-card" data-preset="ig-square" data-w="1080" data-h="1080" data-unit="px" data-dpi="72" type="button">
          <div class="preset-name">Instagram Square</div>
          <div class="preset-dim">1080 × 1080 px (1:1)</div>
        </button>
        <button class="preset-card" data-preset="ig-story" data-w="1080" data-h="1920" data-unit="px" data-dpi="72" type="button">
          <div class="preset-name">Story / Reel / TikTok</div>
          <div class="preset-dim">1080 × 1920 px (9:16)</div>
        </button>
        <button class="preset-card" data-preset="yt-thumb" data-w="1280" data-h="720" data-unit="px" data-dpi="72" type="button">
          <div class="preset-name">YouTube Thumbnail</div>
          <div class="preset-dim">1280 × 720 px (16:9)</div>
        </button>
        <button class="preset-card" data-preset="fhd" data-w="1920" data-h="1080" data-unit="px" data-dpi="72" type="button">
          <div class="preset-name">Full HD 1080p</div>
          <div class="preset-dim">1920 × 1080 px</div>
        </button>
        <button class="preset-card" data-preset="4k" data-w="3840" data-h="2160" data-unit="px" data-dpi="72" type="button">
          <div class="preset-name">4K UHD</div>
          <div class="preset-dim">3840 × 2160 px</div>
        </button>
        <button class="preset-card" data-preset="twitter-header" data-w="1500" data-h="500" data-unit="px" data-dpi="72" type="button">
          <div class="preset-name">Twitter/X Header</div>
          <div class="preset-dim">1500 × 500 px (3:1)</div>
        </button>
      </div>

      <!-- Custom Sizing Controls -->
      <div class="modal-section-title" style="margin-top:14px;">CUSTOM DIMENSIONS & REAL SIZING</div>
      <div class="custom-dim-grid">
        <div class="control">
          <label class="label">Width</label>
          <input type="number" id="docWidth" value="2480" min="10" max="10000">
        </div>
        <div class="control">
          <label class="label">Height</label>
          <input type="number" id="docHeight" value="3508" min="10" max="10000">
        </div>
        <div class="control">
          <label class="label">Unit</label>
          <select id="docUnit">
            <option value="px">Pixels (px)</option>
            <option value="mm">Millimeters (mm)</option>
            <option value="cm">Centimeters (cm)</option>
            <option value="in">Inches (in)</option>
          </select>
        </div>
        <div class="control">
          <label class="label">Resolution (DPI)</label>
          <select id="docDPI">
            <option value="300" selected>300 DPI (High-Res Print)</option>
            <option value="150">150 DPI (Medium Print)</option>
            <option value="72">72 DPI (Web & Screen)</option>
          </select>
        </div>
      </div>

      <div class="doc-options-row">
        <div class="control" style="flex:1;">
          <label class="label">Orientation</label>
          <div class="two">
            <button class="button active" id="orientPortrait" type="button">↕ Portrait</button>
            <button class="button" id="orientLandscape" type="button">↔ Landscape</button>
          </div>
        </div>
        <div class="control" style="flex:1;">
          <label class="label">Background Color</label>
          <div class="bg-color-pickers">
            <button class="bg-choice active" data-color="#ffffff" title="Pure White" type="button" style="background:#ffffff;border:1px solid #ccc;"></button>
            <button class="bg-choice" data-color="transparent" title="Transparent" type="button" style="background:linear-gradient(45deg,#444 25%,transparent 25%),linear-gradient(-45deg,#444 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#444 75%),linear-gradient(-45deg,transparent 75%,#444 75%);background-size:10px 10px;"></button>
            <button class="bg-choice" data-color="#0c0f15" title="Dark Canvas" type="button" style="background:#0c0f15;"></button>
            <button class="bg-choice" data-color="#faf7f0" title="Warm Paper" type="button" style="background:#faf7f0;"></button>
            <input type="color" id="docCustomBg" value="#ffffff" title="Custom color" style="width:28px;height:28px;border-radius:6px;border:none;cursor:pointer;padding:0;">
          </div>
        </div>
      </div>

      <div class="doc-summary-badge" id="docSummaryBadge">
        Output: 2480 × 3508 pixels @ 300 DPI · Pure White Canvas
      </div>
    </div>

    <div class="modal-footer">
      <button class="button" id="cancelNewDocBtn" type="button">Cancel</button>
      <button class="button primary" id="confirmNewDocBtn" type="button">✦ Create Canvas</button>
    </div>
  </div>
</div>


<script>

/* =========================================================
   ART FORGE
========================================================= */

const fileInput =
    document.getElementById("fileInput");

const uploadBox =
    document.getElementById("uploadBox");

const canvas =
    document.getElementById("canvas");

const ctx =
    canvas.getContext("2d");

const emptyState =
    document.getElementById("emptyState");

const imageInfo =
    document.getElementById("imageInfo");

const status =
    document.getElementById("status");

const sizeInfo =
    document.getElementById("sizeInfo");

let originalImage = null;
let originalFile = null;

let exportFormat = "png";


/* =========================================================
   GRADIENT STATE
========================================================= */

let colors = [
    "#ff0055",
    "#7b00ff"
];

let gradientType = "linear";


/* =========================================================
   TEXT STATE
========================================================= */

let textLayers = [];
let selectedTextId = null;


/* =========================================================
   PATTERN STATE
========================================================= */

let patternType = "none";


/* =========================================================
   COLOR UI
========================================================= */

const colorList =
    document.getElementById("colorList");

function renderColors(){

    colorList.innerHTML = "";

    colors.forEach((color,index)=>{

        const row =
            document.createElement("div");

        row.className = "color-row";


        const picker =
            document.createElement("input");

        picker.type = "color";
        picker.className = "color-picker";
        picker.value = color;


        const hex =
            document.createElement("input");

        hex.type = "text";
        hex.className = "color-hex";
        hex.value = color;


        const remove =
            document.createElement("button");

        remove.className = "icon-btn";
        remove.textContent = "×";


        picker.addEventListener("input",()=>{

            colors[index] =
                picker.value;

            hex.value =
                picker.value;

            render();

        });


        hex.addEventListener("change",()=>{

            let value =
                hex.value.trim();

            if(!value.startsWith("#")){
                value = "#" + value;
            }

            if(/^#[0-9a-fA-F]{6}$/.test(value)){

                colors[index] =
                    value;

                picker.value =
                    value;

                render();

            }
            else{

                hex.value =
                    colors[index];

            }

        });


        remove.addEventListener("click",()=>{

            if(colors.length <= 2){
                return;
            }

            colors.splice(index,1);

            renderColors();
            render();

        });


        row.appendChild(picker);
        row.appendChild(hex);
        row.appendChild(remove);

        colorList.appendChild(row);

    });

}

renderColors();


document
.getElementById("addColor")
.addEventListener("click",()=>{

    if(colors.length >= 8){
        return;
    }

    colors.push("#ffffff");

    renderColors();
    render();

});


/* =========================================================
   UPLOAD
========================================================= */

uploadBox.addEventListener("click",e=>{
    e.stopPropagation();
    if(typeof closeNewDocModal === "function") closeNewDocModal();
    fileInput.click();
});


fileInput.addEventListener("change",e=>{
    if(typeof closeNewDocModal === "function") closeNewDocModal();
    const file =
        e.target.files[0];

    if(file){
        loadImage(file);
    }

});


uploadBox.addEventListener("dragover",e=>{

    e.preventDefault();

    uploadBox.classList.add("dragging");

});


uploadBox.addEventListener("dragleave",()=>{

    uploadBox.classList.remove("dragging");

});


uploadBox.addEventListener("drop",e=>{

    e.preventDefault();

    uploadBox.classList.remove("dragging");

    const file =
        e.dataTransfer.files[0];

    if(file){
        loadImage(file);
    }

});

const canvasUploadBox = document.getElementById("canvasUploadBox");
if(canvasUploadBox){
    canvasUploadBox.addEventListener("click", e=>{
        e.stopPropagation();
        if(typeof closeNewDocModal === "function") closeNewDocModal();
        fileInput.click();
    });
    canvasUploadBox.addEventListener("dragover", e=>{
        e.preventDefault();
        e.stopPropagation();
        canvasUploadBox.classList.add("dragging");
    });
    canvasUploadBox.addEventListener("dragleave", e=>{
        e.preventDefault();
        e.stopPropagation();
        canvasUploadBox.classList.remove("dragging");
    });
    canvasUploadBox.addEventListener("drop", e=>{
        e.preventDefault();
        e.stopPropagation();
        canvasUploadBox.classList.remove("dragging");
        if(typeof closeNewDocModal === "function") closeNewDocModal();
        const file = e.dataTransfer.files[0];
        if(file){
            loadImage(file);
        }
    });
}


function loadImage(file){

    if(!/^image\/(jpeg|png|webp)$/.test(file.type)){

        alert(
            "Please upload JPG, PNG or WebP."
        );

        return;
    }

    originalFile = file;

    const url =
        URL.createObjectURL(file);

    const img =
        new Image();

    img.onload = ()=>{

        originalImage = img;

        canvas.width =
            img.naturalWidth;

        canvas.height =
            img.naturalHeight;

        if(interactionCanvas){
            interactionCanvas.width = img.naturalWidth;
            interactionCanvas.height = img.naturalHeight;
        }

        emptyState.style.display =
            "none";

        imageInfo.textContent =
            `${file.name} · ${img.naturalWidth} × ${img.naturalHeight}`;

        status.classList.add("ready");

        layers = [{
            id: "layer-img-" + Date.now(),
            name: file.name ? (file.name.length > 22 ? file.name.substring(0, 20) + "..." : file.name) : "Base Image",
            type: "image",
            img: img,
            visible: true,
            opacity: 100,
            blendMode: "source-over",
            locked: false
        }];
        activeLayerId = layers[0].id;
        if(typeof renderLayersUI === "function") renderLayersUI();

        render();

        URL.revokeObjectURL(url);

    };

    img.onerror = ()=>{

        alert(
            "Unable to read this image."
        );

        URL.revokeObjectURL(url);

    };

    img.src = url;

}


/* =========================================================
   GRADIENT
========================================================= */

function rgba(hex,a){

    hex =
        hex.replace("#","");

    const r =
        parseInt(hex.slice(0,2),16);

    const g =
        parseInt(hex.slice(2,4),16);

    const b =
        parseInt(hex.slice(4,6),16);

    return `rgba(${r},${g},${b},${a})`;
}


function createGradient(){

    const w =
        canvas.width;

    const h =
        canvas.height;

    const type =
        document.getElementById("gradientType").value;

    const opacity =
        Number(
            document.getElementById("gradientOpacity").value
        ) / 100;

    let gradient;


    if(type === "linear"){

        const degrees =
            Number(
                document.getElementById("angle").value
            );

        const radians =
            degrees * Math.PI / 180;

        const cx =
            w / 2;

        const cy =
            h / 2;

        const length =
            Math.abs(w * Math.cos(radians)) +
            Math.abs(h * Math.sin(radians));

        gradient =
            ctx.createLinearGradient(
                cx - Math.cos(radians) * length / 2,
                cy - Math.sin(radians) * length / 2,
                cx + Math.cos(radians) * length / 2,
                cy + Math.sin(radians) * length / 2
            );

    }

    else if(type === "radial"){

        gradient =
            ctx.createRadialGradient(
                w*.5,
                h*.5,
                0,
                w*.5,
                h*.5,
                Math.sqrt(w*w+h*h)*.7
            );

    }

    else{

        const degrees =
            Number(
                document.getElementById("angle").value
            );

        gradient =
            ctx.createConicGradient(
                degrees * Math.PI / 180,
                w*.5,
                h*.5
            );

    }


    colors.forEach((color,index)=>{

        const position =
            index / (colors.length - 1);

        gradient.addColorStop(
            position,
            rgba(color,opacity)
        );

    });

    return gradient;
}


/* =========================================================
   PATTERN
========================================================= */

function drawPattern(){

    if(patternType === "none"){
        return;
    }

    const opacity =
        Number(
            document.getElementById("patternOpacity").value
        ) / 100;

    const size =
        Number(
            document.getElementById("patternSize").value
        );

    const color =
        document.getElementById("patternColor").value;

    const patternCanvas =
        document.createElement("canvas");

    patternCanvas.width =
        size * 2;

    patternCanvas.height =
        size * 2;

    const p =
        patternCanvas.getContext("2d");

    p.strokeStyle =
        rgba(color,opacity);

    p.fillStyle =
        rgba(color,opacity);

    p.lineWidth = 1;


    if(patternType === "dots"){

        p.beginPath();

        p.arc(
            size,
            size,
            1.5,
            0,
            Math.PI*2
        );

        p.fill();

    }


    else if(patternType === "grid"){

        p.beginPath();

        p.moveTo(size,0);
        p.lineTo(size,size*2);

        p.moveTo(0,size);
        p.lineTo(size*2,size);

        p.stroke();

    }


    else if(patternType === "diagonal"){

        p.beginPath();

        p.moveTo(0,size*2);
        p.lineTo(size*2,0);

        p.stroke();

    }


    else if(patternType === "cross"){

        p.beginPath();

        p.moveTo(size,0);
        p.lineTo(size,size*2);

        p.moveTo(0,size);
        p.lineTo(size*2,size);

        p.stroke();

    }


    else if(patternType === "diamond"){

        p.beginPath();

        p.moveTo(size,0);
        p.lineTo(size*2,size);
        p.lineTo(size,size*2);
        p.lineTo(0,size);
        p.closePath();

        p.stroke();

    }


    const pattern =
        ctx.createPattern(
            patternCanvas,
            "repeat"
        );

    ctx.fillStyle =
        pattern;

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

}


/* =========================================================
   TEXTURE
========================================================= */

function drawTexture(){

    const type =
        document.getElementById("textureType").value;

    if(type === "none"){
        return;
    }

    const intensity =
        Number(
            document.getElementById("textureIntensity").value
        ) / 100;


    if(type === "scanlines"){

        ctx.globalAlpha =
            intensity * .45;

        ctx.fillStyle =
            "#000";

        const lineHeight = 4;

        for(
            let y=0;
            y<canvas.height;
            y+=lineHeight
        ){

            ctx.fillRect(
                0,
                y,
                canvas.width,
                1
            );

        }

        ctx.globalAlpha = 1;

        return;
    }


    const noiseCanvas =
        document.createElement("canvas");

    noiseCanvas.width =
        160;

    noiseCanvas.height =
        160;

    const n =
        noiseCanvas.getContext("2d");

    const imageData =
        n.createImageData(
            160,
            160
        );

    const data =
        imageData.data;


    for(
        let i=0;
        i<data.length;
        i+=4
    ){

        const value =
            Math.random()*255;

        data[i] =
            value;

        data[i+1] =
            value;

        data[i+2] =
            value;

        data[i+3] =
            255;

    }


    n.putImageData(
        imageData,
        0,
        0
    );


    const pattern =
        ctx.createPattern(
            noiseCanvas,
            "repeat"
        );

    ctx.globalAlpha =
        type === "soft"
            ? intensity*.12
            : intensity*.22;

    ctx.globalCompositeOperation =
        type === "paper"
            ? "multiply"
            : "overlay";

    ctx.fillStyle =
        pattern;

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.globalAlpha = 1;

    ctx.globalCompositeOperation =
        "source-over";


    if(type === "dust"){

        ctx.globalAlpha =
            intensity*.3;

        ctx.fillStyle =
            "#fff";

        for(
            let i=0;
            i<canvas.width*canvas.height/8000;
            i++
        ){

            const x =
                Math.random()*canvas.width;

            const y =
                Math.random()*canvas.height;

            const size =
                Math.random()*3+1;

            ctx.fillRect(
                x,
                y,
                size,
                size
            );

        }

        ctx.globalAlpha = 1;

    }

}


/* =========================================================
   TEXT DRAWING
========================================================= */

function drawTextLayer(layer){

    const w =
        canvas.width;

    const h =
        canvas.height;

    const x =
        w * layer.x / 100;

    const y =
        h * layer.y / 100;

    ctx.save();

    ctx.globalAlpha =
        layer.opacity;

    ctx.font =
        `${layer.weight} ${layer.size}px "${layer.font}"`;

    ctx.textAlign =
        "center";

    ctx.textBaseline =
        "middle";

    ctx.globalCompositeOperation =
        "source-over";


    if(layer.shadow > 0){

        ctx.shadowColor =
            "rgba(0,0,0,.75)";

        ctx.shadowBlur =
            layer.shadow;

        ctx.shadowOffsetX =
            layer.shadow*.35;

        ctx.shadowOffsetY =
            layer.shadow*.35;

    }


    if(layer.stroke > 0){

        ctx.lineWidth =
            layer.stroke*2;

        ctx.strokeStyle =
            layer.strokeColor;

        ctx.strokeText(
            layer.text,
            x,
            y
        );

    }


    ctx.fillStyle =
        layer.color;


    if(layer.arc && layer.arc !== 0){

        drawCurvedText(
            layer,
            x,
            y,
            layer.arc
        );

    }

    else if(layer.letterSpacing === 0){

        ctx.fillText(
            layer.text,
            x,
            y
        );

    }

    else{

        drawSpacedText(
            layer,
            x,
            y
        );

    }

    ctx.restore();

}


function drawCurvedText(layer,x,y,arcAngle){

    const chars = [...layer.text];
    const angleRad = (arcAngle * Math.PI) / 180;
    let total = 0;
    const widths = chars.map(c => {
        const w = ctx.measureText(c).width + (layer.letterSpacing || 0);
        total += w;
        return w;
    });

    const radius = Math.max(20, total / Math.abs(angleRad));
    const isDown = arcAngle > 0;
    const centerY = isDown ? (y + radius) : (y - radius);
    let currentAngle = isDown ? (-angleRad / 2) : (angleRad / 2);

    chars.forEach((char, idx) => {
        const w = widths[idx];
        const charAngle = (w / total) * angleRad;
        const midAngle = currentAngle + (isDown ? charAngle / 2 : -charAngle / 2);

        ctx.save();
        if(isDown){
            ctx.translate(x + Math.sin(midAngle) * radius, centerY - Math.cos(midAngle) * radius);
            ctx.rotate(midAngle);
        } else {
            ctx.translate(x + Math.sin(midAngle) * radius, centerY + Math.cos(midAngle) * radius);
            ctx.rotate(-midAngle);
        }

        if(layer.stroke > 0){
            ctx.lineWidth = layer.stroke * 2;
            ctx.strokeStyle = layer.strokeColor || "#000000";
            ctx.strokeText(char, 0, 0);
        }
        ctx.fillText(char, 0, 0);
        ctx.restore();

        currentAngle += (isDown ? charAngle : -charAngle);
    });

}


function drawSpacedText(layer,x,y){

    const characters =
        [...layer.text];

    const spacing =
        layer.letterSpacing;

    let total =
        0;

    characters.forEach(char=>{

        total +=
            ctx.measureText(char).width +
            spacing;

    });

    total -= spacing;

    let current =
        x - total/2;

    characters.forEach(char=>{

        const width =
            ctx.measureText(char).width;

        ctx.fillText(
            char,
            current + width/2,
            y
        );

        current +=
            width + spacing;

    });

}


/* =========================================================
   VIGNETTE
========================================================= */

function drawVignette(){

    const value =
        Number(
            document.getElementById("vignette").value
        ) / 100;

    if(value <= 0){
        return;
    }

    const w =
        canvas.width;

    const h =
        canvas.height;

    const gradient =
        ctx.createRadialGradient(
            w/2,
            h/2,
            Math.min(w,h)*.2,
            w/2,
            h/2,
            Math.max(w,h)*.72
        );

    gradient.addColorStop(
        0,
        "rgba(0,0,0,0)"
    );

    gradient.addColorStop(
        1,
        `rgba(0,0,0,${value*.85})`
    );

    ctx.fillStyle =
        gradient;

    ctx.fillRect(
        0,
        0,
        w,
        h
    );

}


/* =========================================================
   RENDER
========================================================= */

function render(){

    if(!originalImage){
        return;
    }

    const brightness =
        Number(
            document.getElementById("brightness").value
        );

    const contrast =
        Number(
            document.getElementById("contrast").value
        );

    const saturation =
        Number(
            document.getElementById("saturation").value
        );

    const blur =
        Number(
            document.getElementById("blur").value
        );


    canvas.width =
        originalImage.naturalWidth;

    canvas.height =
        originalImage.naturalHeight;


    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );


    /* Image */

    ctx.save();

    ctx.filter =
        `brightness(${100+brightness}%)
         contrast(${100+contrast}%)
         saturate(${100+saturation}%)
         blur(${blur}px)`;

    ctx.drawImage(
        originalImage,
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.restore();


    /* Gradient */

    ctx.globalCompositeOperation =
        document.getElementById("gradientBlend").value;

    ctx.fillStyle =
        createGradient();

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.globalCompositeOperation =
        "source-over";


    /* Pattern */

    drawPattern();


    /* Texture */

    drawTexture();


    /* Vignette */

    drawVignette();


    /* Text */

    textLayers.forEach(layer=>{
        drawTextLayer(layer);
    });


    ctx.globalAlpha = 1;

    ctx.globalCompositeOperation =
        "source-over";


    updateInfo();

}


/* =========================================================
   TEXT LAYER SYSTEM
========================================================= */

const textInput =
    document.getElementById("textInput");

const textLayersUI =
    document.getElementById("textLayers");

const textControls =
    document.getElementById("textControls");


document
.getElementById("addText")
.addEventListener("click",()=>{

    const text =
        textInput.value.trim();

    if(!text){
        return;
    }

    const layer = {

        id:
            Date.now(),

        text,

        font:"Inter",

        size:90,

        weight:"700",

        x:50,

        y:50,

        color:"#ffffff",

        opacity:1,

        letterSpacing:0,

        shadow:0,

        stroke:0,

        strokeColor:"#000000"

    };

    textLayers.push(layer);

    selectedTextId =
        layer.id;

    textInput.value = "";

    renderTextLayers();

    loadSelectedText();

    render();

});


function renderTextLayers(){

    textLayersUI.innerHTML = "";

    textLayers.forEach(layer=>{

        const row =
            document.createElement("div");

        row.className =
            "layer" +
            (layer.id === selectedTextId
                ? " active"
                : "");

        const name =
            document.createElement("div");

        name.className =
            "layer-name";

        name.textContent =
            layer.text;


        const del =
            document.createElement("button");

        del.className =
            "layer-delete";

        del.textContent =
            "×";


        row.addEventListener("click",()=>{

            selectedTextId =
                layer.id;

            renderTextLayers();

            loadSelectedText();

            render();

        });


        del.addEventListener("click",e=>{

            e.stopPropagation();

            textLayers =
                textLayers.filter(
                    item =>
                        item.id !== layer.id
                );

            if(selectedTextId === layer.id){

                selectedTextId =
                    textLayers.length
                        ? textLayers[textLayers.length-1].id
                        : null;

            }

            renderTextLayers();
            loadSelectedText();
            render();

        });


        row.appendChild(name);
        row.appendChild(del);

        textLayersUI.appendChild(row);

    });

}


function getSelectedText(){

    return textLayers.find(
        layer =>
            layer.id === selectedTextId
    );

}


function loadSelectedText(){

    const layer =
        getSelectedText();

    if(!layer){

        textControls.style.display =
            "none";

        return;
    }

    textControls.style.display =
        "block";


    document.getElementById("fontFamily").value =
        layer.font || "Inter";

    document.getElementById("fontSize").value =
        layer.size;

    document.getElementById("textArc").value =
        layer.arc || 0;

    document.getElementById("textX").value =
        layer.x;

    document.getElementById("textY").value =
        layer.y;

    document.getElementById("letterSpacing").value =
        layer.letterSpacing;

    document.getElementById("textOpacity").value =
        layer.opacity*100;

    document.getElementById("textColor").value =
        layer.color;

    document.getElementById("textHex").value =
        layer.color;

    document.getElementById("textShadow").value =
        layer.shadow;

    document.getElementById("textStroke").value =
        layer.stroke;

    document.getElementById("textStrokeColor").value =
        layer.strokeColor || "#000000";

    document.getElementById("textStrokeHex").value =
        layer.strokeColor || "#000000";


    updateTextValues();

}


function updateTextLayer(property,value){

    const layer =
        getSelectedText();

    if(!layer){
        return;
    }

    layer[property] =
        value;

    render();

}


function updateTextValues(){

    const layer =
        getSelectedText();

    if(!layer){
        return;
    }

    document.getElementById("fontSizeValue")
        .textContent =
        layer.size;

    document.getElementById("textArcValue")
        .textContent =
        (layer.arc || 0) + "°";

    document.getElementById("textXValue")
        .textContent =
        layer.x + "%";

    document.getElementById("textYValue")
        .textContent =
        layer.y + "%";

    document.getElementById("letterSpacingValue")
        .textContent =
        layer.letterSpacing;

    document.getElementById("textOpacityValue")
        .textContent =
        Math.round(layer.opacity*100) + "%";

    document.getElementById("textShadowValue")
        .textContent =
        layer.shadow;

    document.getElementById("textStrokeValue")
        .textContent =
        layer.stroke;

}


/* TEXT CONTROLS */

document
.getElementById("textArc")
.addEventListener("input",e=>{

    updateTextLayer(
        "arc",
        Number(e.target.value)
    );

    updateTextValues();

});


document
.getElementById("textStrokeColor")
.addEventListener("input",e=>{

    updateTextLayer(
        "strokeColor",
        e.target.value
    );

    document.getElementById("textStrokeHex").value =
        e.target.value;

});


document
.getElementById("textStrokeHex")
.addEventListener("change",e=>{

    let v = e.target.value.trim();
    if(!v.startsWith("#")) v = "#" + v;
    if(/^#[0-9a-fA-F]{6}$/.test(v)){
        updateTextLayer("strokeColor", v);
        document.getElementById("textStrokeColor").value = v;
    } else {
        const l = getSelectedText();
        e.target.value = l ? (l.strokeColor || "#000000") : "#000000";
    }

});

document
.getElementById("fontFamily")
.addEventListener("change",e=>{

    updateTextLayer(
        "font",
        e.target.value
    );

});


document
.getElementById("fontSize")
.addEventListener("input",e=>{

    updateTextLayer(
        "size",
        Number(e.target.value)
    );

    updateTextValues();

});


document
.getElementById("textX")
.addEventListener("input",e=>{

    updateTextLayer(
        "x",
        Number(e.target.value)
    );

    updateTextValues();

});


document
.getElementById("textY")
.addEventListener("input",e=>{

    updateTextLayer(
        "y",
        Number(e.target.value)
    );

    updateTextValues();

});


document
.getElementById("letterSpacing")
.addEventListener("input",e=>{

    updateTextLayer(
        "letterSpacing",
        Number(e.target.value)
    );

    updateTextValues();

});


document
.getElementById("textOpacity")
.addEventListener("input",e=>{

    updateTextLayer(
        "opacity",
        Number(e.target.value)/100
    );

    updateTextValues();

});


document
.getElementById("textColor")
.addEventListener("input",e=>{

    const layer =
        getSelectedText();

    if(!layer){
        return;
    }

    layer.color =
        e.target.value;

    document.getElementById("textHex")
        .value =
        e.target.value;

    render();

});


document
.getElementById("textHex")
.addEventListener("change",e=>{

    let value =
        e.target.value.trim();

    if(!value.startsWith("#")){
        value = "#" + value;
    }

    if(/^#[0-9a-fA-F]{6}$/.test(value)){

        const layer =
            getSelectedText();

        if(layer){

            layer.color =
                value;

            document.getElementById("textColor")
                .value =
                value;

            render();

        }

    }

});


document
.getElementById("textShadow")
.addEventListener("input",e=>{

    updateTextLayer(
        "shadow",
        Number(e.target.value)
    );

    updateTextValues();

});


document
.getElementById("textStroke")
.addEventListener("input",e=>{

    updateTextLayer(
        "stroke",
        Number(e.target.value)
    );

    updateTextValues();

});


document
.getElementById("deleteText")
.addEventListener("click",()=>{

    if(!selectedTextId){
        return;
    }

    textLayers =
        textLayers.filter(
            layer =>
                layer.id !== selectedTextId
        );

    selectedTextId =
        textLayers.length
            ? textLayers[textLayers.length-1].id
            : null;

    renderTextLayers();
    loadSelectedText();
    render();

});


/* =========================================================
   PATTERN CONTROLS
========================================================= */

document
.querySelectorAll(".pattern-option")
.forEach(button=>{

    button.addEventListener("click",()=>{

        document
        .querySelectorAll(".pattern-option")
        .forEach(item=>{
            item.classList.remove("active");
        });

        button.classList.add("active");

        patternType =
            button.dataset.pattern;

        document.getElementById("patternControls")
            .style.display =
                patternType === "none"
                    ? "none"
                    : "block";

        render();

    });

});


document
.getElementById("patternOpacity")
.addEventListener("input",e=>{

    document.getElementById("patternOpacityValue")
        .textContent =
        e.target.value + "%";

    render();

});


document
.getElementById("patternSize")
.addEventListener("input",e=>{

    document.getElementById("patternSizeValue")
        .textContent =
        e.target.value;

    render();

});


document
.getElementById("patternColor")
.addEventListener("input",render);


/* =========================================================
   TEXTURE CONTROLS
========================================================= */

document
.getElementById("textureType")
.addEventListener("change",e=>{

    const active =
        e.target.value !== "none";

    document.getElementById("textureControls")
        .style.display =
        active
            ? "block"
            : "none";

    render();

});


document
.getElementById("textureIntensity")
.addEventListener("input",e=>{

    document.getElementById("textureIntensityValue")
        .textContent =
        e.target.value + "%";

    render();

});


/* =========================================================
   GRADIENT CONTROLS
========================================================= */

document
.getElementById("gradientType")
.addEventListener("change",render);

document
.getElementById("gradientBlend")
.addEventListener("change",render);


document
.getElementById("angle")
.addEventListener("input",e=>{

    document.getElementById("angleValue")
        .textContent =
        e.target.value + "°";

    render();

});


document
.getElementById("gradientOpacity")
.addEventListener("input",e=>{

    document.getElementById("gradientOpacityValue")
        .textContent =
        e.target.value + "%";

    render();

});


/* PRESETS */

document
.querySelectorAll(".preset")
.forEach(button=>{

    button.addEventListener("click",()=>{

        document
        .querySelectorAll(".preset")
        .forEach(item=>{
            item.classList.remove("active");
        });

        button.classList.add("active");

        colors =
            button.dataset.colors.split(",");

        renderColors();
        render();

    });

});


/* =========================================================
   IMAGE ADJUSTMENTS
========================================================= */

const adjustments = [
    ["brightness","brightnessValue"],
    ["contrast","contrastValue"],
    ["saturation","saturationValue"],
    ["blur","blurValue"],
    ["vignette","vignetteValue"]
];

adjustments.forEach(([id,valueId])=>{

    document
    .getElementById(id)
    .addEventListener("input",e=>{

        let suffix = "";

        if(
            id === "vignette"
        ){
            suffix = "%";
        }

        document
        .getElementById(valueId)
        .textContent =
            e.target.value + suffix;

        render();

    });

});


