}

function drawBrushDab(ctxTarget, x, y, brushType, size, opacity, flow, color){
  ctxTarget.save();
  ctxTarget.globalAlpha = (opacity / 100) * (flow / 100);

  if(brushType === "eraser" || activeTool === "eraser"){
    ctxTarget.globalCompositeOperation = "destination-out";
    ctxTarget.beginPath();
    ctxTarget.arc(x, y, size / 2, 0, Math.PI * 2);
    ctxTarget.fill();
    ctxTarget.restore();
    return;
  }

  ctxTarget.globalCompositeOperation = document.getElementById("brushBlendMode").value || "source-over";

  switch(brushType){
    case "hard-round":
      ctxTarget.fillStyle = color;
      ctxTarget.beginPath();
      ctxTarget.arc(x, y, size / 2, 0, Math.PI * 2);
      ctxTarget.fill();
      break;

    case "soft-round": {
      const grad = ctxTarget.createRadialGradient(x, y, 0, x, y, size / 2);
      grad.addColorStop(0, color);
      grad.addColorStop(0.7, color);
      grad.addColorStop(1, "transparent");
      ctxTarget.fillStyle = grad;
      ctxTarget.beginPath();
      ctxTarget.arc(x, y, size / 2, 0, Math.PI * 2);
      ctxTarget.fill();
      break;
    }

    case "airbrush": {
      ctxTarget.fillStyle = color;
      const count = Math.max(8, Math.round(size * 0.7));
      for(let i = 0; i < count; i++){
        const radius = (Math.random() * size) / 2;
        const angle = Math.random() * Math.PI * 2;
        const px = x + Math.cos(angle) * radius;
        const py = y + Math.sin(angle) * radius;
        const dotSize = 0.5 + Math.random() * (size * 0.08);
        ctxTarget.beginPath();
        ctxTarget.arc(px, py, dotSize, 0, Math.PI * 2);
        ctxTarget.fill();
      }
      break;
    }

    case "calligraphy": {
      ctxTarget.fillStyle = color;
      ctxTarget.beginPath();
      ctxTarget.ellipse(x, y, size / 2, size / 6, -Math.PI / 4, 0, Math.PI * 2);
      ctxTarget.fill();
      break;
    }

    case "sparkle": {
      ctxTarget.fillStyle = color;
      const arm = (size / 2) * (0.8 + Math.random() * 0.4);
      ctxTarget.translate(x, y);
      ctxTarget.rotate(Math.random() * Math.PI);
      ctxTarget.beginPath();
      ctxTarget.moveTo(0, -arm);
      ctxTarget.quadraticCurveTo(0, 0, arm, 0);
      ctxTarget.quadraticCurveTo(0, 0, 0, arm);
      ctxTarget.quadraticCurveTo(0, 0, -arm, 0);
      ctxTarget.quadraticCurveTo(0, 0, 0, -arm);
      ctxTarget.fill();
      break;
    }

    case "cloud-brush": {
      ctxTarget.fillStyle = color;
      const puffs = 3;
      for(let i = 0; i < puffs; i++){
        const ox = (Math.random() - 0.5) * size * 0.5;
        const oy = (Math.random() - 0.5) * size * 0.5;
        const rad = (size / 3) * (0.7 + Math.random() * 0.5);
        const grad = ctxTarget.createRadialGradient(x + ox, y + oy, 0, x + ox, y + oy, rad);
        grad.addColorStop(0, color);
        grad.addColorStop(0.5, color);
        grad.addColorStop(1, "transparent");
        ctxTarget.fillStyle = grad;
        ctxTarget.beginPath();
        ctxTarget.arc(x + ox, y + oy, rad, 0, Math.PI * 2);
        ctxTarget.fill();
      }
      break;
    }

    case "neon-glow": {
      ctxTarget.shadowColor = color;
      ctxTarget.shadowBlur = size * 0.8;
      ctxTarget.fillStyle = color;
      ctxTarget.beginPath();
      ctxTarget.arc(x, y, size * 0.35, 0, Math.PI * 2);
      ctxTarget.fill();
      ctxTarget.shadowBlur = 0;
      ctxTarget.fillStyle = "#ffffff";
      ctxTarget.beginPath();
      ctxTarget.arc(x, y, size * 0.15, 0, Math.PI * 2);
      ctxTarget.fill();
      break;
    }
  }

  ctxTarget.restore();
}

