  document.getElementById("penFillHex").value = e.target.value;
  redrawPenOverlay();
});
document.getElementById("penStrokeStyle")?.addEventListener("change", redrawPenOverlay);

function redrawPenOverlay(){
  if(!interactionCtx || !interactionCanvas) return;
  interactionCtx.clearRect(0, 0, interactionCanvas.width, interactionCanvas.height);

  if(activePenPath.points.length === 0) return;

  const pts = activePenPath.points;
  const strokeW = Number(document.getElementById("penStrokeWidth").value) || 4;
  const strokeCol = document.getElementById("penStrokeColor").value || "#00d4ff";
  const strokeStyle = document.getElementById("penStrokeStyle").value || "solid";
  const fillEnabled = document.getElementById("penFillEnabled").checked;
  const fillCol = document.getElementById("penFillColor").value || "#7656ff";

  interactionCtx.save();
  interactionCtx.beginPath();
  interactionCtx.moveTo(pts[0].x, pts[0].y);

  for(let i = 1; i < pts.length; i++){
    const prev = pts[i - 1];
    const curr = pts[i];
    const cp1 = prev.handleOut || { x: prev.x, y: prev.y };
    const cp2 = curr.handleIn || { x: curr.x, y: curr.y };
    interactionCtx.bezierCurveTo(cp1.x, cp1.y, cp2.x, cp2.y, curr.x, curr.y);
  }

  if(activePenPath.isClosed && pts.length > 2){
    const last = pts[pts.length - 1];
    const first = pts[0];
    const cp1 = last.handleOut || { x: last.x, y: last.y };
    const cp2 = first.handleIn || { x: first.x, y: first.y };
    interactionCtx.bezierCurveTo(cp1.x, cp1.y, cp2.x, cp2.y, first.x, first.y);
    interactionCtx.closePath();

    if(fillEnabled){
      interactionCtx.fillStyle = fillCol;
      interactionCtx.globalAlpha = 0.45;
      interactionCtx.fill();
      interactionCtx.globalAlpha = 1;
    }
  }

  interactionCtx.lineWidth = strokeW;
  interactionCtx.strokeStyle = strokeCol;
  if(strokeStyle === "dashed") interactionCtx.setLineDash([12, 6]);
  else if(strokeStyle === "dotted") interactionCtx.setLineDash([4, 4]);
  else interactionCtx.setLineDash([]);
  interactionCtx.stroke();
  interactionCtx.setLineDash([]);

  // Draw CS6 style handles and anchor boxes
  pts.forEach((p, idx)=>{
    if(p.handleIn && (p.handleIn.x !== p.x || p.handleIn.y !== p.y)){
      interactionCtx.beginPath();
      interactionCtx.moveTo(p.x, p.y);
      interactionCtx.lineTo(p.handleIn.x, p.handleIn.y);
      interactionCtx.lineWidth = 1.5;
      interactionCtx.strokeStyle = "rgba(0,212,255,0.75)";
      interactionCtx.stroke();

      interactionCtx.beginPath();
      interactionCtx.arc(p.handleIn.x, p.handleIn.y, 4, 0, Math.PI * 2);
      interactionCtx.fillStyle = "#00d4ff";
      interactionCtx.fill();
    }

    if(p.handleOut && (p.handleOut.x !== p.x || p.handleOut.y !== p.y)){
      interactionCtx.beginPath();
      interactionCtx.moveTo(p.x, p.y);
      interactionCtx.lineTo(p.handleOut.x, p.handleOut.y);
      interactionCtx.lineWidth = 1.5;
      interactionCtx.strokeStyle = "rgba(0,212,255,0.75)";
      interactionCtx.stroke();

      interactionCtx.beginPath();
      interactionCtx.arc(p.handleOut.x, p.handleOut.y, 4, 0, Math.PI * 2);
      interactionCtx.fillStyle = "#00d4ff";
      interactionCtx.fill();
    }

    interactionCtx.beginPath();
    interactionCtx.rect(p.x - 4.5, p.y - 4.5, 9, 9);
    interactionCtx.fillStyle = (idx === activeAnchorIndex) ? "#ff3545" : "#ffffff";
    interactionCtx.fill();
    interactionCtx.lineWidth = 2;
    interactionCtx.strokeStyle = "#0077ff";
    interactionCtx.stroke();

    if(idx === 0){
      interactionCtx.beginPath();
      interactionCtx.arc(p.x, p.y, 8.5, 0, Math.PI * 2);
      interactionCtx.lineWidth = 1.5;
      interactionCtx.strokeStyle = "rgba(0,212,255,0.85)";
      interactionCtx.stroke();
    }
  });

  interactionCtx.restore();
}

document.getElementById("closePenPathBtn")?.addEventListener("click", ()=>{
  if(activePenPath.points.length > 2){
    activePenPath.isClosed = true;
    redrawPenOverlay();
  }
});
document.getElementById("clearPenPathBtn")?.addEventListener("click", ()=>{
  activePenPath = { points: [], isClosed: false };
  clearInteractionOverlay();
});
document.getElementById("commitPenPathBtn")?.addEventListener("click", ()=>{
  if(activePenPath.points.length < 2){
    alert("Draw at least 2 anchor points before saving as vector layer.");
    return;
  }
  const count = layers.filter(l => l.type === "pen").length + 1;
  const newPenLayer = {
    id: "layer-pen-" + Date.now(),
    name: "Pen Path " + count,
    type: "pen",
    visible: true,
    opacity: 100,
    blendMode: "source-over",
    locked: false,
    data: {
      points: JSON.parse(JSON.stringify(activePenPath.points)),
      isClosed: activePenPath.isClosed,
      strokeWidth: Number(document.getElementById("penStrokeWidth").value) || 4,
      strokeColor: document.getElementById("penStrokeColor").value || "#00d4ff",
      strokeStyle: document.getElementById("penStrokeStyle").value || "solid",
      fillEnabled: document.getElementById("penFillEnabled").checked,
      fillColor: document.getElementById("penFillColor").value || "#7656ff"
    }
  };
  layers.push(newPenLayer);
  activeLayerId = newPenLayer.id;
  activePenPath = { points: [], isClosed: false };
  clearInteractionOverlay();
  renderLayersUI();
  render();
  pushHistory();
});

function drawPenLayer(layer){
  const data = layer.data;
  if(!data || !data.points || data.points.length === 0) return;
  const pts = data.points;

  ctx.save();
  ctx.beginPath();
  ctx.moveTo(pts[0].x, pts[0].y);

  for(let i = 1; i < pts.length; i++){
    const prev = pts[i - 1];
    const curr = pts[i];
    const cp1 = prev.handleOut || { x: prev.x, y: prev.y };
    const cp2 = curr.handleIn || { x: curr.x, y: curr.y };
    ctx.bezierCurveTo(cp1.x, cp1.y, cp2.x, cp2.y, curr.x, curr.y);
  }

  if(data.isClosed && pts.length > 2){
    const last = pts[pts.length - 1];
    const first = pts[0];
    const cp1 = last.handleOut || { x: last.x, y: last.y };
    const cp2 = first.handleIn || { x: first.x, y: first.y };
    ctx.bezierCurveTo(cp1.x, cp1.y, cp2.x, cp2.y, first.x, first.y);
    ctx.closePath();

    if(data.fillEnabled && data.fillColor){
      ctx.fillStyle = data.fillColor;
      ctx.fill();
    }
  }

  if(data.strokeWidth > 0 && data.strokeColor){
    ctx.lineWidth = data.strokeWidth;
    ctx.strokeStyle = data.strokeColor;
    if(data.strokeStyle === "dashed") ctx.setLineDash([12, 6]);
    else if(data.strokeStyle === "dotted") ctx.setLineDash([4, 4]);
    else ctx.setLineDash([]);
    ctx.stroke();
  }

  ctx.restore();
}

